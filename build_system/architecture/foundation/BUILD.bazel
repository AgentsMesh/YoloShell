load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/*.rs"])

filegroup(
    name = "architecture_check_data",
    srcs = _SOURCES + glob(["unit_tests/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "library",
    srcs = _SOURCES,
    crate_name = "yolo_architecture_foundation",
    crate_root = "src/lib.rs",
    edition = "2024",
)

rust_test(
    name = "unit_tests",
    srcs = _SOURCES + glob(["unit_tests/*.rs"]),
    crate_name = "yolo_architecture_foundation_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
)
