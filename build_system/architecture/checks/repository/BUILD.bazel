load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

SOURCES = glob(["src/*.rs"])

UNIT_TEST_SOURCES = glob(["unit_tests/*.rs"])

COMPONENT_DATA = [
    "//build_system/architecture/checks/repository/codex/hook:architecture_check_data",
    "//build_system/architecture/checks/repository/contract:architecture_check_data",
    "//build_system/architecture/checks/repository/literal:architecture_check_data",
    "//build_system/architecture/checks/repository/foundation:architecture_check_data",
    "//build_system/architecture/checks/repository/ui:architecture_check_data",
]

DEPS = [
    "//build_system/architecture/foundation:library",
    "//build_system/architecture/checks/repository/codex/hook:library",
    "//build_system/architecture/checks/repository/contract:library",
    "//build_system/architecture/checks/repository/literal:library",
    "//build_system/architecture/checks/repository/ui:library",
]

filegroup(
    name = "architecture_check_data",
    srcs = SOURCES + UNIT_TEST_SOURCES + COMPONENT_DATA + ["BUILD.bazel"],
)

rust_library(
    name = "library",
    srcs = SOURCES,
    crate_name = "yolo_architecture_repository_policy",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = DEPS,
)

rust_test(
    name = "facade_unit_tests",
    srcs = SOURCES + UNIT_TEST_SOURCES,
    crate_name = "yolo_architecture_repository_policy_facade_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = DEPS + [
        "//build_system/architecture/checks/repository/foundation:library",
        "//build_system/architecture/checks/source:library",
        "//build_system/architecture/test_support:library",
    ],
)

test_suite(
    name = "unit_tests",
    tests = [
        ":facade_unit_tests",
        "//build_system/architecture/checks/repository/codex/hook:unit_tests",
        "//build_system/architecture/checks/repository/contract:unit_tests",
        "//build_system/architecture/checks/repository/literal:unit_tests",
        "//build_system/architecture/checks/repository/ui:unit_tests",
    ],
)
