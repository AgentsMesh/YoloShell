load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

SOURCES = glob(["src/*.rs"])

filegroup(
    name = "architecture_check_data",
    srcs = SOURCES + ["BUILD.bazel"],
)

rust_library(
    name = "library",
    srcs = SOURCES,
    crate_name = "yolo_architecture_repository_policy_foundation",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["//build_system/architecture/foundation:library"],
)
