load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

SOURCES = glob(["src/**/*.rs"])

INTERNAL_TEST_SOURCES = [
    "unit_tests/authority_site_constructor_tests.rs",
    "unit_tests/closure_flow_boundary_tests.rs",
    "unit_tests/retained_operation_boundary_tests.rs",
]

filegroup(
    name = "architecture_check_data",
    srcs = SOURCES + glob(["unit_tests/*.rs"]) + ["BUILD.bazel"],
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/*.rs"]),
    crate_name = "yolo_architecture_process_signal_foundation_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = [
        ":library",
        "//build_system/architecture/contracts:library",
        "//build_system/architecture/syntax:library",
    ],
)

rust_library(
    name = "library",
    srcs = SOURCES,
    crate_name = "yolo_architecture_process_signal_foundation",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//build_system/architecture/foundation:library",
        "//build_system/architecture/contracts:library",
        "//build_system/architecture/checks/process/signal/path:library",
        "//build_system/architecture/checks/source:library",
        "//build_system/architecture/syntax:library",
    ],
)

rust_test(
    name = "internal_unit_tests",
    srcs = SOURCES + INTERNAL_TEST_SOURCES,
    crate_name = "yolo_architecture_process_signal_foundation_internal_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//build_system/architecture/foundation:library",
        "//build_system/architecture/contracts:library",
        "//build_system/architecture/checks/process/signal/path:library",
        "//build_system/architecture/checks/source:library",
        "//build_system/architecture/syntax:library",
    ],
)
