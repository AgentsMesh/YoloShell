load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/**/*.rs"])

_TEST_SOURCES = glob([
    "unit_tests/*.rs",
    "test_support/*.rs",
])

_DEPS = [
    "//build_system/architecture/foundation:library",
    "//build_system/architecture/contracts:library",
    "//build_system/architecture/checks/process/signal/foundation:library",
    "//build_system/architecture/checks/source:library",
    "//build_system/architecture/syntax:library",
]

filegroup(
    name = "architecture_check_data",
    srcs = _SOURCES + _TEST_SOURCES + ["BUILD.bazel"],
)

rust_library(
    name = "library",
    srcs = _SOURCES,
    crate_name = "yolo_architecture_process_signal_child_policy",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = _SOURCES + _TEST_SOURCES,
    crate_name = "yolo_architecture_process_signal_child_policy_tests",
    crate_root = "src/lib.rs",
    data = [
        "//core/crates/application/broker/child/custody:architecture_check_data",
        "//core/crates/application/host/cli:architecture_check_data",
    ],
    edition = "2024",
    deps = _DEPS,
)
