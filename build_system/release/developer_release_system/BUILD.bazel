load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/platform/macos:config.bzl", "RELEASE_EVIDENCE_MACOS_MINIMUM_OS_ENV")
load("//build_system/bazel/rust:test_features.bzl", "TEST_CONFIGURATION_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/*.rs"])

_DEPS = [
    "//build_system/release/acceptance_receipt:library",
    "//build_system/release/archive_audit:library",
    "//build_system/release/contracts:library",
    "//build_system/release/delivery_foundation:library",
    "//build_system/release/delivery_workflow:library",
    "//build_system/release/evidence_model:library",
    "//build_system/release/filesystem:library",
    "//build_system/release/foundation:library",
    "//build_system/release/gate_system:library",
    "//build_system/release/process_execution:library",
    "//build_system/release/verification:library",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:tempfile",
]

_TEST_DEPS = [
    dependency
    for dependency in _DEPS
    if dependency not in [
        "//build_system/release/acceptance_receipt:library",
        "//build_system/release/delivery_foundation:library",
        "//build_system/release/delivery_workflow:library",
        "//build_system/release/verification:library",
    ]
] + [
    "//build_system/release/acceptance_receipt:test_support",
    "//build_system/release/delivery_foundation:test_support",
    "//build_system/release/delivery_workflow:test_support",
    "//build_system/release/verification:test_support",
]

filegroup(
    name = "architecture_check_data",
    srcs = _SOURCES + glob(["unit_tests/*.rs"]) + ["BUILD.bazel"],
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/*.rs"]),
    crate_name = "yolo_release_developer_release_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = [
        ":library",
        "//build_system/release/contracts:library",
    ],
)

rust_library(
    name = "library",
    srcs = _SOURCES,
    crate_name = "yolo_release_developer_release_system",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = RELEASE_EVIDENCE_MACOS_MINIMUM_OS_ENV,
    deps = _DEPS,
)

rust_library(
    name = "test_support",
    testonly = True,
    srcs = _SOURCES,
    crate_name = "yolo_release_developer_release_system",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = RELEASE_EVIDENCE_MACOS_MINIMUM_OS_ENV,
    rustc_flags = TEST_CONFIGURATION_RUSTC_FLAGS,
    deps = _TEST_DEPS,
)
