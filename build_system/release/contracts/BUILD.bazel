load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/platform/macos:config.bzl", "RELEASE_EVIDENCE_MACOS_MINIMUM_OS_ENV")

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/*.rs"])

_UNIT_TEST_SOURCES = glob(["unit_tests/*.rs"])

filegroup(
    name = "architecture_check_data",
    srcs = _SOURCES + _UNIT_TEST_SOURCES + ["BUILD.bazel"],
)

rust_library(
    name = "library",
    srcs = _SOURCES,
    crate_name = "yolo_release_contracts",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = RELEASE_EVIDENCE_MACOS_MINIMUM_OS_ENV,
    deps = ["@crates//:libc"],
)

rust_test(
    name = "unit_tests",
    srcs = _UNIT_TEST_SOURCES,
    crate_name = "yolo_release_contracts_unit_tests",
    crate_root = "unit_tests/lib.rs",
    data = _SOURCES,
    edition = "2024",
    rustc_env = RELEASE_EVIDENCE_MACOS_MINIMUM_OS_ENV,
    deps = [":library", "//core/crates/build_image:yolo_build_image"],
)
