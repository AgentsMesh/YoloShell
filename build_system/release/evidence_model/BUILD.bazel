load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/*.rs"])

_UNIT_TEST_SOURCES = glob(["unit_tests/*.rs"])

filegroup(
    name = "architecture_check_data",
    srcs = _SOURCES + _UNIT_TEST_SOURCES + ["BUILD.bazel"],
)

rust_library(
    name = "library",
    srcs = _SOURCES,
    crate_name = "yolo_release_evidence_model",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["//core/crates/distribution/bundle:yolo_distribution_bundle", "@crates//:serde"],
)

rust_test(
    name = "unit_tests",
    srcs = _UNIT_TEST_SOURCES,
    crate_name = "yolo_release_evidence_model_unit_tests",
    crate_root = "unit_tests/lib.rs",
    data = _SOURCES,
    edition = "2024",
    deps = [
        ":library",
        "@crates//:serde_json",
    ],
)
