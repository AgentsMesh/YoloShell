load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/*.rs", "unit_tests/*.rs", "test_support/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "source_contract",
    srcs = glob(["src/*.rs"]),
    crate_name = "yolo_coverage_source_contract",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["//build_system/coverage/protocol"],
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/*.rs", "test_support/*.rs"]),
    crate_name = "yolo_coverage_source_contract_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    data = [
        "//build_system/release/contracts:architecture_check_data",
        "//build_system/release/evidence_model:architecture_check_data",
        "//core/crates/persistence/maintenance/contract:architecture_check_data",
        "//core/crates/transport/session:architecture_check_data",
    ],
    deps = [
        ":source_contract",
        "//build_system/coverage/protocol",
    ],
)
