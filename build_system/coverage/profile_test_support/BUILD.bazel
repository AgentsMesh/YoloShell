load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

SOURCES = glob(["src/*.rs"])

UNIT_TEST_SOURCES = glob(["unit_tests/*.rs"])

filegroup(
    name = "architecture_check_data",
    srcs = SOURCES + UNIT_TEST_SOURCES + ["BUILD.bazel"],
)

rust_library(
    name = "library",
    testonly = True,
    srcs = SOURCES,
    crate_name = "yolo_coverage_test_support",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["@crates//:libc"],
)

rust_test(
    name = "unit_tests",
    srcs = SOURCES + UNIT_TEST_SOURCES,
    crate_name = "yolo_coverage_test_support_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = ["//build_system/coverage/protocol", "@crates//:libc", "@crates//:tempfile"],
)
