+/// Allocate one physical counter per surviving mapped BCB, without assuming
+/// balanced flow across calls, unwinds, suspension, or process termination.
+pub(crate) fn direct_counters(
+    bcb_needs_counter: &DenseBitSet<BasicCoverageBlock>,
+    bcbs_seen: &DenseBitSet<BasicCoverageBlock>,
+) -> CoverageCounters {
+    let mut counters = CoverageCounters::with_num_bcbs(bcb_needs_counter.domain_size());
+    for bcb in bcb_needs_counter.iter() {
+        let term = if bcbs_seen.contains(bcb) {
+            counters.ensure_phys_counter(bcb)
+        } else {
+            // Keep optimized-away mappings in the denominator with zero hits.
+            CovTerm::Zero
+        };
+        counters.set_node_counter(bcb, term);
+    }
+    counters
+}
