
load(
    "//build_system/architecture:topology.bzl",
    "YOLO_AGENT_CORE",
    "YOLO_APPLICATION_SUPPORT",
    "YOLO_CLAUDE_HOOK_CONTRACT",
    "YOLO_CRYPTO",
    "YOLO_PATHS",
    "YOLO_PATHS_PERSISTENCE_TEST_SUPPORT",
    "YOLO_PERSISTENCE_CUSTODY",
    "YOLO_PERSISTENCE_CUSTODY_RESILIENCE_SUPPORT",
    "YOLO_PROCESS",
    "YOLO_PROCESS_ADVERSARIAL",
    "YOLO_TERMINAL_MODEL",
)
load("//build_system/bazel/rust:component_test_graph.bzl", "component_test_aliases", "component_test_dependencies")

PATHS_COMPONENT = YOLO_PATHS
PATHS_TEST_SUPPORT = YOLO_PATHS_PERSISTENCE_TEST_SUPPORT
PROCESS_COMPONENT = YOLO_PROCESS
PROCESS_TEST_SUPPORT = YOLO_PROCESS_ADVERSARIAL
PERSISTENCE_CUSTODY = YOLO_PERSISTENCE_CUSTODY
PERSISTENCE_CUSTODY_RESILIENCE_SUPPORT = YOLO_PERSISTENCE_CUSTODY_RESILIENCE_SUPPORT

CUSTODY_DEPS = [
    YOLO_CLAUDE_HOOK_CONTRACT,
    YOLO_APPLICATION_SUPPORT,
    YOLO_CRYPTO,
    PATHS_COMPONENT,
    PERSISTENCE_CUSTODY,
    PROCESS_COMPONENT,
    YOLO_TERMINAL_MODEL,
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:uuid",
]

CUSTODY_UNIT_TEST_ALIASES = component_test_aliases(CUSTODY_DEPS)

CUSTODY_UNIT_TEST_DEPS = component_test_dependencies(CUSTODY_DEPS) + [
    YOLO_AGENT_CORE,
    "@crates//:libc",
    "@crates//:tempfile",
]

CUSTODY_RESILIENCE_DEPS = [
    dependency
    for dependency in CUSTODY_DEPS
    if dependency not in [PROCESS_COMPONENT, PERSISTENCE_CUSTODY]
] + [PROCESS_TEST_SUPPORT, PERSISTENCE_CUSTODY_RESILIENCE_SUPPORT]
