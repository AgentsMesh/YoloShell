STORE_UNIT_TEST_DEPS = [
    dependency
    for dependency in STORE_DEPS
    if dependency not in [
        BINDING_IO_COMPONENT,
        CLAUDE_COMPONENT,
        CLAUDE_HOOKS_COMPONENT,
        CODEX_COMPONENT,
        HOOK_GENERATION_COMPONENT,
        PATHS_COMPONENT,
    ]
] + [
    BINDING_IO_TEST_SUPPORT,
    HOOK_GENERATION_TEST_SUPPORT,
    CLAUDE_HOOKS_TEST_SUPPORT,
    CLAUDE_TEST_SUPPORT,
    CODEX_TEST_SUPPORT,
    PATHS_TEST_SUPPORT,
    YOLO_AGENT_DETECTION,
