+    /// Returns the one-based (row, column) for a cursor position report.
+    ///
+    /// In DEC origin mode the row is relative to the top scrolling margin;
+    /// otherwise it is relative to the screen. A pending line wrap reports
+    /// the last column, never a column outside the terminal. The active grid
+    /// is used regardless of the displayed scrollback offset.
+    /// This does not change the cursor or consume a pending line wrap.
+    #[must_use]
+    pub fn report_cursor_position(&self) -> (u16, u16) {
+        let pos = self.grid().report_pos();
+        (pos.row + 1, pos.col + 1)
+    }
