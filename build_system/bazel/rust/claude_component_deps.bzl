
load(
    "//build_system/architecture:topology.bzl",
    "YOLO_AGENT_ADAPTER_CONTRACT",
    "YOLO_AGENT_AUTHORITY_CONTRACT",
    "YOLO_AGENT_BINDING_IO",
    "YOLO_AGENT_BINDING_IO_TEST_SUPPORT",
    "YOLO_AGENT_CONTRACT",
    "YOLO_AGENT_CORE",
    "YOLO_AGENT_DETECTION",
    "YOLO_AGENT_PROVIDERS",
    "YOLO_APPLICATION_SUPPORT",
    "YOLO_CLAUDE_CUSTODY",
    "YOLO_CLAUDE_HOOKS_RESILIENCE_SUPPORT",
    "YOLO_CLAUDE_HOOK_CONTRACT",
    "YOLO_CRYPTO",
    "YOLO_PATHS",
    "YOLO_PATHS_PERSISTENCE_TEST_SUPPORT",
    "YOLO_PROCESS",
    "YOLO_PROCESS_ADVERSARIAL",
    "YOLO_TERMINAL_MODEL",
)
BINDING_IO_COMPONENT = YOLO_AGENT_BINDING_IO
BINDING_IO_TEST_SUPPORT = YOLO_AGENT_BINDING_IO_TEST_SUPPORT
CLAUDE_HOOKS_TEST_SUPPORT = YOLO_CLAUDE_HOOKS_RESILIENCE_SUPPORT
PATHS_COMPONENT = YOLO_PATHS
PATHS_TEST_SUPPORT = YOLO_PATHS_PERSISTENCE_TEST_SUPPORT
PROCESS_COMPONENT = YOLO_PROCESS
PROCESS_TEST_SUPPORT = YOLO_PROCESS_ADVERSARIAL

CLAUDE_DEPS = [
    YOLO_AGENT_CONTRACT,
    YOLO_AGENT_ADAPTER_CONTRACT,
    YOLO_AGENT_CORE,
    YOLO_AGENT_AUTHORITY_CONTRACT,
    BINDING_IO_COMPONENT,
    "//core/crates/agent/providers/claude/provider:yolo_claude_identity",
    YOLO_CLAUDE_HOOK_CONTRACT,
    YOLO_APPLICATION_SUPPORT,
    YOLO_CRYPTO,
    PATHS_COMPONENT,
    PROCESS_COMPONENT,
    YOLO_TERMINAL_MODEL,
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:uuid",
]

_PROCESS_TEST_BASE_DEPS = [
    dependency
    for dependency in CLAUDE_DEPS
    if dependency != PROCESS_COMPONENT
]

CLAUDE_UNIT_TEST_DEPS = _PROCESS_TEST_BASE_DEPS + [
    CLAUDE_HOOKS_TEST_SUPPORT,
    PROCESS_TEST_SUPPORT,
    YOLO_CLAUDE_CUSTODY,
    YOLO_AGENT_DETECTION,
    YOLO_AGENT_PROVIDERS,
    "//core/crates/agent/system/store:yolo_agent_store_test_support",
    "@crates//:tempfile",
]

CLAUDE_INTEGRATION_TEST_DEPS = _PROCESS_TEST_BASE_DEPS + [
    PROCESS_TEST_SUPPORT,
    "@crates//:tempfile",
]

CLAUDE_RESILIENCE_DEPS = _PROCESS_TEST_BASE_DEPS + [PROCESS_TEST_SUPPORT]

CLAUDE_STORE_TEST_DEPS = [
    dependency
    for dependency in CLAUDE_DEPS
    if dependency not in [
        BINDING_IO_COMPONENT,
        PATHS_COMPONENT,
        PROCESS_COMPONENT,
    ]
] + [
    BINDING_IO_TEST_SUPPORT,
    PATHS_TEST_SUPPORT,
    PROCESS_TEST_SUPPORT,
]
