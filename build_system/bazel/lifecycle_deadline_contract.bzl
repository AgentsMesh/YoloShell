"""Generates the Rust lifecycle deadline contract."""

_RUST_INSPECTION_SECONDS = 30
_DURABLE_STARTUP_IO_SECONDS = 75
_HOST_STARTUP_SETTLEMENT_SECONDS = 15
_STARTUP_RESPONSE_MARGIN_SECONDS = 15
_GRACEFUL_TERMINATION_SECONDS = 2
_GRACEFUL_TERMINATION_POLL_MILLISECONDS = 25
_FORCE_TERMINATION_SECONDS = 2
_FORCE_TERMINATION_CONFIRM_SECONDS = 2
_PTY_MISSING_EOF_SECONDS = 2
_PROCESS_SCAN_MARGIN_SECONDS = 2
_WORKER_AUTH_MARGIN_SECONDS = 2
_HOST_PROCESS_EXIT_SECONDS = 2
_AGENT_HOOK_REQUEST_SECONDS = 5
_AGENT_HOOK_RESPONSE_SECONDS = 5
_AGENT_HOOK_ABORT_SECONDS = 1
_HOST_ARCHIVE_SETTLEMENT_SECONDS = 2
_LINUX_CONTAINMENT_RECOVERY_SECONDS = 5
_LIFECYCLE_RESPONSE_MARGIN_SECONDS = 15
_CONNECTION_BOOTSTRAP_SECONDS = 60
_MANAGEMENT_RESPONSE_MARGIN_SECONDS = 15
_SSH_OPERATION_SECONDS = 30
_RUNTIME_OPEN_SETTLEMENT_SECONDS = 15
_REMOTE_RESPONSE_MARGIN_SECONDS = 15
_RUST_OUTPUT_PATH = "src/generated/%{name}.rs"

_HOST_WORKER_READINESS_SECONDS = (
    _DURABLE_STARTUP_IO_SECONDS +
    _HOST_STARTUP_SETTLEMENT_SECONDS
)
_STARTUP_CLIENT_SECONDS = _HOST_WORKER_READINESS_SECONDS + _STARTUP_RESPONSE_MARGIN_SECONDS

_TERMINATION_DRAIN_SECONDS = (
    _GRACEFUL_TERMINATION_SECONDS * 2 +
    _FORCE_TERMINATION_SECONDS +
    _FORCE_TERMINATION_CONFIRM_SECONDS +
    _PTY_MISSING_EOF_SECONDS
)
_WORKER_TERMINATION_SECONDS = _TERMINATION_DRAIN_SECONDS + _PROCESS_SCAN_MARGIN_SECONDS
_WORKER_AUTH_SECONDS = _WORKER_TERMINATION_SECONDS + _WORKER_AUTH_MARGIN_SECONDS
_HOST_DEFERRED_SETTLEMENT_SECONDS = (
    _WORKER_TERMINATION_SECONDS +
    _HOST_PROCESS_EXIT_SECONDS
)
_RESUME_LIFECYCLE_WAIT_SECONDS = _HOST_DEFERRED_SETTLEMENT_SECONDS
_AGENT_HOOK_DRAIN_SECONDS = (
    _AGENT_HOOK_REQUEST_SECONDS + _AGENT_HOOK_RESPONSE_SECONDS + _AGENT_HOOK_ABORT_SECONDS * 2
)
_WORKER_RESPONSE_DRAIN_SECONDS = _STARTUP_RESPONSE_MARGIN_SECONDS
_WORKER_SHUTDOWN_SETTLEMENT_SECONDS = (
    _AGENT_HOOK_DRAIN_SECONDS * 2 + _WORKER_RESPONSE_DRAIN_SECONDS + _HOST_STARTUP_SETTLEMENT_SECONDS
)
_RESUME_INNER_SECONDS = (
    _RESUME_LIFECYCLE_WAIT_SECONDS + _WORKER_SHUTDOWN_SETTLEMENT_SECONDS + _HOST_WORKER_READINESS_SECONDS
)
_RESUME_CLIENT_SECONDS = _RESUME_INNER_SECONDS + _STARTUP_RESPONSE_MARGIN_SECONDS
_LIFECYCLE_INNER_SECONDS = (
    _WORKER_AUTH_SECONDS +
    _WORKER_TERMINATION_SECONDS +
    _HOST_DEFERRED_SETTLEMENT_SECONDS +
    _HOST_ARCHIVE_SETTLEMENT_SECONDS +
    _LINUX_CONTAINMENT_RECOVERY_SECONDS
)
_LIFECYCLE_CLIENT_SECONDS = _LIFECYCLE_INNER_SECONDS + _LIFECYCLE_RESPONSE_MARGIN_SECONDS
_RUNTIME_OPEN_SECONDS = (
    _CONNECTION_BOOTSTRAP_SECONDS +
    _SSH_OPERATION_SECONDS +
    _RUNTIME_OPEN_SETTLEMENT_SECONDS
)
_BROKER_READY_SECONDS = _CONNECTION_BOOTSTRAP_SECONDS + _MANAGEMENT_RESPONSE_MARGIN_SECONDS
_BROKER_CLIENT_SECONDS = _BROKER_READY_SECONDS + _MANAGEMENT_RESPONSE_MARGIN_SECONDS
_REMOTE_INNER_SECONDS = max(
    _RESUME_INNER_SECONDS,
    _LIFECYCLE_INNER_SECONDS,
    _RUST_INSPECTION_SECONDS,
)
_REMOTE_LIFECYCLE_CLIENT_SECONDS = (
    _RUNTIME_OPEN_SECONDS +
    _REMOTE_INNER_SECONDS +
    _REMOTE_RESPONSE_MARGIN_SECONDS
)

def _rust_duration(name, seconds):
    return "pub const %s: Duration = Duration::from_secs(%s);\n" % (name, seconds)

def _rust_contract_impl(ctx):
    values = [
        ("RUST_INSPECTION_CLIENT_TIMEOUT", _RUST_INSPECTION_SECONDS),
        ("SESSION_DURABLE_STARTUP_IO_BUDGET", _DURABLE_STARTUP_IO_SECONDS),
        ("SESSION_DURABLE_STARTUP_SETTLEMENT_MARGIN", _HOST_STARTUP_SETTLEMENT_SECONDS),
        ("SESSION_STARTUP_RESPONSE_SETTLEMENT_MARGIN", _STARTUP_RESPONSE_MARGIN_SECONDS),
        ("GRACEFUL_TERMINATION_TIMEOUT", _GRACEFUL_TERMINATION_SECONDS),
        ("FORCE_TERMINATION_TIMEOUT", _FORCE_TERMINATION_SECONDS),
        ("FORCE_TERMINATION_CONFIRM_TIMEOUT", _FORCE_TERMINATION_CONFIRM_SECONDS),
        ("PTY_MISSING_EOF_TIMEOUT", _PTY_MISSING_EOF_SECONDS),
        ("PROCESS_SCAN_DEADLINE_OVERRUN_MARGIN", _PROCESS_SCAN_MARGIN_SECONDS),
        ("WORKER_AUTH_RESPONSE_MARGIN", _WORKER_AUTH_MARGIN_SECONDS),
        ("HOST_PROCESS_EXIT_TIMEOUT", _HOST_PROCESS_EXIT_SECONDS),
        ("AGENT_HOOK_REQUEST_TIMEOUT", _AGENT_HOOK_REQUEST_SECONDS),
        ("AGENT_HOOK_RESPONSE_TIMEOUT", _AGENT_HOOK_RESPONSE_SECONDS),
        ("AGENT_HOOK_ABORT_TIMEOUT", _AGENT_HOOK_ABORT_SECONDS),
        ("AGENT_HOOK_DRAIN_TIMEOUT", _AGENT_HOOK_DRAIN_SECONDS),
        ("WORKER_RESPONSE_DRAIN_TIMEOUT", _WORKER_RESPONSE_DRAIN_SECONDS),
        ("WORKER_SHUTDOWN_SETTLEMENT_TIMEOUT", _WORKER_SHUTDOWN_SETTLEMENT_SECONDS),
        ("HOST_DEFERRED_TERMINATION_SETTLEMENT_TIMEOUT", _HOST_DEFERRED_SETTLEMENT_SECONDS),
        ("SESSION_RESUME_LIFECYCLE_LOCK_TIMEOUT", _RESUME_LIFECYCLE_WAIT_SECONDS),
        ("SESSION_RESUME_INNER_BUDGET", _RESUME_INNER_SECONDS),
        ("SESSION_RESUME_CLIENT_TIMEOUT", _RESUME_CLIENT_SECONDS),
        ("HOST_ARCHIVE_SETTLEMENT_TIMEOUT", _HOST_ARCHIVE_SETTLEMENT_SECONDS),
        ("LINUX_CONTAINMENT_RECOVERY_TIMEOUT", _LINUX_CONTAINMENT_RECOVERY_SECONDS),
        ("SESSION_LIFECYCLE_RESPONSE_SETTLEMENT_MARGIN", _LIFECYCLE_RESPONSE_MARGIN_SECONDS),
        ("REMOTE_CONNECTION_BOOTSTRAP_TIMEOUT", _CONNECTION_BOOTSTRAP_SECONDS),
        ("REMOTE_MANAGEMENT_RESPONSE_MARGIN", _MANAGEMENT_RESPONSE_MARGIN_SECONDS),
        ("REMOTE_SSH_OPERATION_TIMEOUT", _SSH_OPERATION_SECONDS),
        ("REMOTE_RUNTIME_OPEN_SETTLEMENT_MARGIN", _RUNTIME_OPEN_SETTLEMENT_SECONDS),
        ("REMOTE_OPERATION_RESPONSE_MARGIN", _REMOTE_RESPONSE_MARGIN_SECONDS),
        ("REMOTE_EXISTING_RUNTIME_INNER_BUDGET", _REMOTE_INNER_SECONDS),
    ]
    content = "use std::time::Duration;\n" + "".join([
        _rust_duration(name, seconds)
        for name, seconds in values
    ])
    content += (
        "pub const GRACEFUL_TERMINATION_POLL_INTERVAL: Duration = " +
        "Duration::from_millis(%s);\n" % _GRACEFUL_TERMINATION_POLL_MILLISECONDS
    )
    ctx.actions.write(ctx.outputs.out, content)

_rust_contract = rule(
    implementation = _rust_contract_impl,
    outputs = {"out": _RUST_OUTPUT_PATH},
)

def lifecycle_deadline_rust_contract(name):
    _rust_contract(name = name)

def _hub_rust_contract_impl(ctx):
    values = [
        ("HUB_CREATE_TIMEOUT", _STARTUP_CLIENT_SECONDS + _REMOTE_RESPONSE_MARGIN_SECONDS),
        ("HUB_RESUME_TIMEOUT", _RESUME_CLIENT_SECONDS + _REMOTE_RESPONSE_MARGIN_SECONDS),
        ("HUB_LIFECYCLE_TIMEOUT", _LIFECYCLE_CLIENT_SECONDS + _REMOTE_RESPONSE_MARGIN_SECONDS),
    ]
    ctx.actions.write(ctx.outputs.out, "use std::time::Duration;\n" + "".join([
        _rust_duration(name, seconds)
        for name, seconds in values
    ]))

hub_lifecycle_deadline_rust_contract = rule(
    implementation = _hub_rust_contract_impl,
    outputs = {"out": _RUST_OUTPUT_PATH},
)
