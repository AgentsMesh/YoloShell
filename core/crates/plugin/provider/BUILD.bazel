load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/contract:yolo_agent_contract",
    "@crates//:serde",
    "@crates//:thiserror",
]

rust_library(
    name = "yolo_plugin_provider",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_plugin_provider",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_plugin_provider_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
    "//core/crates/agent/providers/claude/provider:yolo_claude_identity",
    "//core/crates/agent/providers/codex/provider:yolo_codex_identity",
    "//core/crates/agent/providers/gemini/provider:yolo_gemini_identity",
    "//core/crates/agent/providers/grok/provider:yolo_grok_identity",
    "//core/crates/agent/providers/qwen/provider:yolo_qwen_identity",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs"]),
    crate_name = "yolo_plugin_provider_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_plugin_provider",
        "//core/crates/agent/providers/claude/provider:yolo_claude_identity",
        "//core/crates/agent/providers/codex/provider:yolo_codex_identity",
        "//core/crates/agent/providers/gemini/provider:yolo_gemini_identity",
        "//core/crates/agent/providers/grok/provider:yolo_grok_identity",
        "//core/crates/agent/providers/qwen/provider:yolo_qwen_identity",
        "@crates//:serde_json",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"],
)
