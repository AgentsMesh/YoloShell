load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/plugin/api:yolo_plugin_api",
    "@crates//:serde",
    "@crates//:serde_json",
]

filegroup(name = "architecture_check_data", srcs = glob(["**/*.rs"]) + ["BUILD.bazel"])

rust_library(
    name = "yolo_trusted_plugin_manifest",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_trusted_plugin_manifest",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/**/*.rs"], allow_empty = True),
    crate_name = "yolo_trusted_plugin_manifest_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [":yolo_trusted_plugin_manifest", "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol"],
)
