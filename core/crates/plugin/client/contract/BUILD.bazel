load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/plugin/api:yolo_plugin_api",
    "@crates//:serde",
    "@crates//:thiserror",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_builtin_client_contract",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_builtin_client_contract",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/**/*.rs"]),
    crate_name = "yolo_builtin_client_contract_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [":yolo_builtin_client_contract", "//core/crates/hub/identity:yolo_hub_identity"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs"]),
    crate_name = "yolo_builtin_client_contract_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_builtin_client_contract",
        "//clients/tui/descriptor:yolo_tui_descriptor",
    ],
)
