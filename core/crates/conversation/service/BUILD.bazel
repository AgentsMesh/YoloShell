load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/contract:yolo_agent_contract",
    "//core/crates/conversation/protocol:yolo_conversation_protocol",
    "//core/crates/conversation/source:yolo_conversation_source",
    "//core/crates/conversation/transcript:yolo_conversation_transcript",
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_conversation_service",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_conversation_service",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_conversation_service_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/agent/providers/claude/provider:yolo_claude_provider",
        "//core/crates/agent/providers/codex/provider:yolo_codex_provider",
        "//core/crates/agent/providers/gemini/provider:yolo_gemini_provider",
        "//core/crates/agent/providers/grok/provider:yolo_grok_provider",
        "//core/crates/agent/providers/qwen/provider:yolo_qwen_provider",
        "//core/crates/hub/identity:yolo_hub_identity",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs"]),
    crate_name = "yolo_conversation_service_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_conversation_service",
        "//core/crates/agent/providers/claude:yolo_claude",
        "//core/crates/agent/providers/codex:yolo_codex",
        "//core/crates/agent/providers/claude/provider:yolo_claude_provider",
        "//core/crates/agent/providers/codex/provider:yolo_codex_provider",
        "//core/crates/agent/providers/gemini/provider:yolo_gemini_provider",
        "//core/crates/agent/providers/grok/provider:yolo_grok_provider",
        "//core/crates/agent/providers/qwen/provider:yolo_qwen_provider",
        "//core/crates/hub/identity:yolo_hub_identity",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)
