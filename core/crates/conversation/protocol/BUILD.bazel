load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/hub/identity:yolo_hub_identity",
    "@crates//:serde",
    "@crates//:serde_json",
]

rust_library(
    name = "yolo_conversation_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_conversation_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_conversation_protocol_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"],
)
