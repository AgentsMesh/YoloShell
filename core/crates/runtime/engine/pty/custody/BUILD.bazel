load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load("//build_system/bazel/rust:test_features.bzl", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_PATHS_COMPONENT = "//core/crates/persistence/paths:yolo_paths"

_PATHS_TEST_SUPPORT = "//core/crates/persistence/paths:yolo_paths_persistence_test_support"

_PROCESS_IDENTITY_COMPONENT = "//core/crates/runtime/engine/process/identity:yolo_process_identity"

_PROCESS_IDENTITY_TEST_SUPPORT = "//core/crates/runtime/engine/process/identity:yolo_process_identity_test_support"

_DEPS = [
    "//core/crates/crypto:yolo_crypto",
    _PATHS_COMPONENT,
    _PROCESS_IDENTITY_COMPONENT,
    "//core/crates/terminal/model:yolo_terminal_model",
    "//core/crates/transport/local/unix:yolo_local_unix",
    "//core/crates/wire:yolo_wire",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:tokio",
    "@crates//:uuid",
]

_TEST_DEPS = [dependency for dependency in _DEPS if dependency != _PROCESS_IDENTITY_COMPONENT] + [
    "//core/crates/agent/system/core:yolo_agent_core",
    "//core/crates/application/support:yolo_application_support",
    _PROCESS_IDENTITY_TEST_SUPPORT,
    "@crates//:serde_json",
    "@crates//:tempfile",
]

rust_library(
    name = "yolo_pty_custody",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_pty_custody",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

isolated_rust_test(
    name = "yolo_pty_custody_unit_tests",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
        ":unit_test_sources",
    ],
    aliases = {_PROCESS_IDENTITY_TEST_SUPPORT: "yolo_process_identity"},
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_pty_custody_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

rust_library(
    name = "yolo_pty_custody_test_support",
    testonly = True,
    srcs = glob([
        "src/**/*.rs",
        "test_support/**/*.rs",
    ]),
    aliases = {_PROCESS_IDENTITY_TEST_SUPPORT: "yolo_process_identity"},
    crate_features = [
        "adversarial-test-hooks",
        "yolo-test-support",
    ],
    crate_name = "yolo_pty_custody",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

rust_library(
    name = "yolo_pty_custody_persistence_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = {_PATHS_TEST_SUPPORT: "yolo_paths"},
    crate_name = "yolo_pty_custody",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [dependency for dependency in _DEPS if dependency != _PATHS_COMPONENT] + [
        _PATHS_TEST_SUPPORT,
    ],
)

filegroup(
    name = "runtime_sources",
    srcs = glob(["src/**/*.rs"]),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(
        ["integration_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "test_sources",
    testonly = True,
    srcs = [
        ":integration_test_sources",
        ":unit_test_sources",
    ],
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
)

rust_library(
    name = "yolo_pty_custody_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + glob(
        ["test_support/**/*.rs"],
        allow_empty = True,
    ),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_pty_custody",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS) + ["@crates//:tempfile"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
