load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/build_image:yolo_build_image",
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/runtime/engine/process:yolo_process",
    "@crates//:anyhow",
    "@crates//:libc",
]

rust_library(
    name = "yolo_executable_identity",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_executable_identity",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_features = ["yolo-unit-tests"],
    crate_name = "yolo_executable_identity_unit_tests",
    edition = "2024",
    deps = _DEPS + ["@crates//:sha2"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["src/**/*.rs", "integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_features = ["yolo-integration-tests"],
    crate_name = "yolo_executable_identity_integration_tests",
    edition = "2024",
    deps = _DEPS + ["@crates//:sha2", "@crates//:tempfile"],
)

filegroup(name = "architecture_check_data", srcs = glob(["**/*.rs"]) + ["BUILD.bazel"])
