load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/runtime/engine/protocol:yolo_runtime_protocol",
    "//core/crates/transport/capnp/codec",
    "//core/crates/transport/capnp/rpc",
    "//core/crates/wire:yolo_wire",
    "@crates//:tokio",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_host_change_feed",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_host_change_feed",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs"]) + ["BUILD.bazel"],
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_host_change_feed_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)
