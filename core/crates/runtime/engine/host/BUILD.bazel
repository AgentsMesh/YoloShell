load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load(
    "//build_system/bazel/rust:config.bzl",
    "CLAUDE_SCHEMA_FIXTURES",
    "RUST_UNIT_TEST_THREAD_COUNT",
    "TEST_ENVIRONMENT",
)
load("//build_system/bazel/rust:host_component_deps.bzl", "HOST_DEPS", "HOST_TEST_ALIASES", "HOST_TEST_DEPS")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load(
    "//build_system/bazel/rust:test_features.bzl",
    "INTEGRATION_TEST_FEATURES",
    "UNIT_TEST_FEATURES",
)
load(
    "//build_system/bazel/rust:unit_test_fixtures.bzl",
    "UNIT_TEST_FIXTURE_DATA",
    "TEST_RUNTIME_TARGET",
    "unit_test_fixture_environment",
)

package(default_visibility = ["//visibility:public"])

_DEPS = HOST_DEPS

rust_library(
    name = "yolo_host",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_host",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

isolated_rust_test(
    name = "yolo_host_unit_tests",
    coverage_objects = [TEST_RUNTIME_TARGET],
    timeout = "eternal",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
        ":unit_test_sources",
    ],
    aliases = HOST_TEST_ALIASES,
    compile_data = CLAUDE_SCHEMA_FIXTURES,
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_host_unit_tests",
    crate_root = "src/lib.rs",
    data = CLAUDE_SCHEMA_FIXTURES + UNIT_TEST_FIXTURE_DATA,
    edition = "2024",
    env = unit_test_fixture_environment(RUST_UNIT_TEST_THREAD_COUNT),
    env_inherit = TEST_ENVIRONMENT,
    deps = HOST_TEST_DEPS,
)

isolated_rust_test(
    name = "yolo_host_unit_creation_tests",
    coverage_objects = [TEST_RUNTIME_TARGET], timeout = "eternal",
    srcs = [":runtime_sources", ":test_support_sources", ":unit_test_sources"],
    aliases = HOST_TEST_ALIASES, compile_data = CLAUDE_SCHEMA_FIXTURES,
    crate_features = UNIT_TEST_FEATURES, crate_name = "yolo_host_unit_creation_tests",
    crate_root = "src/lib.rs",
    data = CLAUDE_SCHEMA_FIXTURES + UNIT_TEST_FIXTURE_DATA, edition = "2024",
    env = dict(unit_test_fixture_environment(RUST_UNIT_TEST_THREAD_COUNT), TESTBRIDGE_TEST_ONLY = "host::tests::creation"),
    env_inherit = TEST_ENVIRONMENT, tags = ["manual"],
    deps = HOST_TEST_DEPS,
)

isolated_rust_test(
    name = "yolo_host_unit_resume_tests",
    coverage_objects = [TEST_RUNTIME_TARGET], timeout = "eternal",
    srcs = [":runtime_sources", ":test_support_sources", ":unit_test_sources"],
    aliases = HOST_TEST_ALIASES, compile_data = CLAUDE_SCHEMA_FIXTURES,
    crate_features = UNIT_TEST_FEATURES, crate_name = "yolo_host_unit_resume_tests",
    crate_root = "src/lib.rs",
    data = CLAUDE_SCHEMA_FIXTURES + UNIT_TEST_FIXTURE_DATA, edition = "2024",
    env = dict(unit_test_fixture_environment(RUST_UNIT_TEST_THREAD_COUNT), TESTBRIDGE_TEST_ONLY = "host::tests::resume"),
    env_inherit = TEST_ENVIRONMENT, tags = ["manual"],
    deps = HOST_TEST_DEPS,
)

isolated_rust_test(
    name = "yolo_host_unit_catalog_tests",
    coverage_objects = [TEST_RUNTIME_TARGET], timeout = "eternal",
    srcs = [":runtime_sources", ":test_support_sources", ":unit_test_sources"],
    aliases = HOST_TEST_ALIASES, compile_data = CLAUDE_SCHEMA_FIXTURES,
    crate_features = UNIT_TEST_FEATURES, crate_name = "yolo_host_unit_catalog_tests",
    crate_root = "src/lib.rs",
    data = CLAUDE_SCHEMA_FIXTURES + UNIT_TEST_FIXTURE_DATA, edition = "2024",
    env = dict(unit_test_fixture_environment(RUST_UNIT_TEST_THREAD_COUNT), TESTBRIDGE_TEST_ONLY = "host::tests::catalog"),
    env_inherit = TEST_ENVIRONMENT, tags = ["manual"],
    deps = HOST_TEST_DEPS,
)

test_suite(name = "yolo_host_unit_shards", tests = [":yolo_host_unit_creation_tests", ":yolo_host_unit_resume_tests", ":yolo_host_unit_catalog_tests"])

isolated_rust_test(
    name = "yolo_host_integration_tests",
    coverage_objects = [TEST_RUNTIME_TARGET],
    timeout = "eternal",
    srcs = [
        ":integration_test_sources",
        ":runtime_sources",
        ":test_support_sources",
    ],
    aliases = HOST_TEST_ALIASES,
    compile_data = CLAUDE_SCHEMA_FIXTURES,
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_host_integration_tests",
    crate_root = "src/lib.rs",
    data = CLAUDE_SCHEMA_FIXTURES + UNIT_TEST_FIXTURE_DATA,
    edition = "2024",
    env = unit_test_fixture_environment(RUST_UNIT_TEST_THREAD_COUNT),
    env_inherit = TEST_ENVIRONMENT,
    deps = HOST_TEST_DEPS,
)

rust_library(
    name = "yolo_host_adversarial_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + [":test_support_sources"],
    aliases = {
        "//core/crates/runtime/engine/process:yolo_process_adversarial": "yolo_process_test_support",
    },
    crate_features = ["failed-rearm-test-hooks"],
    crate_name = "yolo_host",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["//core/crates/runtime/engine/process:yolo_process_adversarial"],
)

filegroup(
    name = "runtime_sources",
    srcs = glob(["src/**/*.rs"]),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(
        ["integration_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
)

rust_library(
    name = "yolo_host_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + glob(
        ["test_support/**/*.rs"],
        allow_empty = True,
    ),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES + [
        "custody-release-test-hooks",
        "reconcile-test-hooks",
    ],
    crate_name = "yolo_host",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS) + ["@crates//:tempfile"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
