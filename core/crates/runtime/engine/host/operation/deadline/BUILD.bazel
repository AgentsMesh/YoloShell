load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

_DEPS = ["@crates//:tokio"]

rust_library(
    name = "yolo_host_operation_deadline",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_host_operation_deadline",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_library(
    name = "yolo_host_operation_deadline_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["yolo-test-support"],
    crate_name = "yolo_host_operation_deadline",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs"], allow_empty = True) + ["BUILD.bazel"],
)
