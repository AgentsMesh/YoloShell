load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_DEPS = ["@crates//:tokio"]

rust_library(
    name = "yolo_host_shutdown_signal",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_host_shutdown_signal",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"], allow_empty = True),
    crate_name = "yolo_host_shutdown_signal_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"], allow_empty = True) + ["BUILD.bazel"],
)
