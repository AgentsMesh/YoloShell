load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/process/spawn:yolo_process_spawn",
    "//core/crates/runtime/engine/process:yolo_process",
    "//core/crates/runtime/engine/protocol:yolo_runtime_protocol",
    "//core/crates/wire:yolo_wire",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
]

rust_library(
    name = "yolo_host_workspace",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_host_workspace",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"], allow_empty = True),
    crate_name = "yolo_host_workspace_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["@crates//:tempfile"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"], allow_empty = True) + ["BUILD.bazel"],
)
