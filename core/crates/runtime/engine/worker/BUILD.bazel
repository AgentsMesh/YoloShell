load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load(
    "//build_system/bazel/rust:config.bzl",
    "CLAUDE_SCHEMA_FIXTURES",
    "RUST_UNIT_TEST_THREAD_COUNT",
    "TEST_ENVIRONMENT",
)
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load(
    "//build_system/bazel/rust:test_features.bzl",
    "INTEGRATION_TEST_FEATURES",
    "UNIT_TEST_FEATURES",
)
load(
    "//build_system/bazel/rust:unit_test_fixtures.bzl",
    "UNIT_TEST_FIXTURE_DATA",
    "TEST_RUNTIME_TARGET",
    "unit_test_fixture_environment",
)
load("//build_system/bazel/rust:worker_component_deps.bzl", "WORKER_DEPS", "WORKER_TEST_ALIASES", "WORKER_TEST_DEPS")

package(default_visibility = ["//visibility:public"])

_DEPS = WORKER_DEPS

rust_library(
    name = "yolo_worker",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_worker",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

isolated_rust_test(
    name = "yolo_worker_unit_runtime_tests",
    coverage_objects = [TEST_RUNTIME_TARGET],
    timeout = "eternal",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
    ] + glob(["unit_tests/**/*.rs"]),
    aliases = WORKER_TEST_ALIASES,
    compile_data = CLAUDE_SCHEMA_FIXTURES,
    crate_features = UNIT_TEST_FEATURES + ["yolo-worker-unit-runtime"],
    crate_name = "yolo_worker_unit_runtime_tests",
    crate_root = "src/lib.rs",
    data = CLAUDE_SCHEMA_FIXTURES + UNIT_TEST_FIXTURE_DATA,
    edition = "2024",
    env = unit_test_fixture_environment(RUST_UNIT_TEST_THREAD_COUNT),
    env_inherit = TEST_ENVIRONMENT,
    deps = WORKER_TEST_DEPS,
)

isolated_rust_test(
    name = "yolo_worker_unit_custody_tests",
    coverage_objects = [TEST_RUNTIME_TARGET],
    timeout = "eternal",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
    ] + glob(["unit_tests/**/*.rs"]),
    aliases = WORKER_TEST_ALIASES,
    compile_data = CLAUDE_SCHEMA_FIXTURES,
    crate_features = UNIT_TEST_FEATURES + ["yolo-worker-unit-attachment", "yolo-worker-unit-dispatch", "yolo-worker-unit-finalization", "yolo-worker-unit-journal", "yolo-worker-unit-lease", "yolo-worker-unit-state"],
    crate_name = "yolo_worker_unit_custody_tests",
    crate_root = "src/lib.rs",
    data = CLAUDE_SCHEMA_FIXTURES + UNIT_TEST_FIXTURE_DATA,
    edition = "2024",
    env = unit_test_fixture_environment(RUST_UNIT_TEST_THREAD_COUNT),
    env_inherit = TEST_ENVIRONMENT,
    deps = WORKER_TEST_DEPS,
)

isolated_rust_test(
    name = "yolo_worker_unit_startup_tests",
    coverage_objects = [TEST_RUNTIME_TARGET],
    timeout = "eternal",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
    ] + glob(["unit_tests/**/*.rs"]),
    aliases = WORKER_TEST_ALIASES,
    compile_data = CLAUDE_SCHEMA_FIXTURES,
    crate_features = UNIT_TEST_FEATURES + ["yolo-worker-unit-bootstrap", "yolo-worker-unit-environment", "yolo-worker-unit-native_control", "yolo-worker-unit-protocol", "yolo-worker-unit-startup", "yolo-worker-unit-terminal"],
    crate_name = "yolo_worker_unit_startup_tests",
    crate_root = "src/lib.rs",
    data = CLAUDE_SCHEMA_FIXTURES + UNIT_TEST_FIXTURE_DATA,
    edition = "2024",
    env = unit_test_fixture_environment(RUST_UNIT_TEST_THREAD_COUNT),
    env_inherit = TEST_ENVIRONMENT,
    deps = WORKER_TEST_DEPS,
)

test_suite(
    name = "yolo_worker_unit_tests",
    tests = [
        ":yolo_worker_unit_runtime_tests",
        ":yolo_worker_unit_custody_tests",
        ":yolo_worker_unit_startup_tests",
    ],
)

isolated_rust_test(
    name = "yolo_worker_integration_tests",
    coverage_objects = [TEST_RUNTIME_TARGET],
    timeout = "eternal",
    srcs = [
        ":integration_test_sources",
        ":runtime_sources",
        ":test_support_sources",
    ],
    aliases = WORKER_TEST_ALIASES,
    compile_data = CLAUDE_SCHEMA_FIXTURES,
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_worker_integration_tests",
    crate_root = "src/lib.rs",
    data = CLAUDE_SCHEMA_FIXTURES + UNIT_TEST_FIXTURE_DATA,
    edition = "2024",
    env = unit_test_fixture_environment(RUST_UNIT_TEST_THREAD_COUNT),
    env_inherit = TEST_ENVIRONMENT,
    deps = WORKER_TEST_DEPS,
)

filegroup(
    name = "runtime_sources",
    srcs = glob(["src/**/*.rs"]),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(
        ["integration_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
)

rust_library(
    name = "yolo_worker_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + glob(
        ["test_support/**/*.rs"],
        allow_empty = True,
    ),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES + [
        "host-test-hooks",
        "startup-handoff-test-hooks",
        "termination-test-hooks",
    ],
    crate_name = "yolo_worker",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS) + [
        "//core/crates/application/support:yolo_application_test_fixtures",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
