load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/system/core:yolo_agent_core",
    "@crates//:portable-pty",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_worker_context_env",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_worker_context_env",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_worker_context_env_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]) + ["BUILD.bazel"],
)
