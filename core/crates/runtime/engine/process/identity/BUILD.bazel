load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load(
    "//build_system/bazel/rust:test_features.bzl",
    "INTEGRATION_TEST_FEATURES",
    "UNIT_TEST_FEATURES",
)

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:sha2",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_process_identity",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_process_identity",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_library(
    name = "yolo_process_identity_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + ["test_support/identity_relation.rs"],
    crate_features = ["identity-test-support"],
    crate_name = "yolo_process_identity",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob([
        "src/**/*.rs",
        "test_support/**/*.rs",
        "unit_tests/**/*.rs",
    ]),
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_process_identity_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/process/spawn:yolo_process_spawn",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob([
        "integration_tests/**/*.rs",
        "src/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_process_identity_integration_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["//core/crates/process/spawn:yolo_process_spawn"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)
