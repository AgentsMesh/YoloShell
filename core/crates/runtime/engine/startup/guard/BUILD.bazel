load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = ["//core/crates/transport/capnp/codec", "@crates//:anyhow", "@crates//:libc", "@crates//:serde", "@crates//:tokio"]

rust_library(
    name = "yolo_startup_guard",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_startup_guard",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_startup_guard_unit_tests",
    edition = "2024",
    deps = _DEPS,
)

rust_binary(
    name = "startup_parent",
    testonly = True,
    srcs = ["test_support/parent.rs"],
    crate_root = "test_support/parent.rs",
    crate_name = "yolo_startup_parent_fixture",
    edition = "2024",
    deps = [":yolo_startup_guard", "//core/crates/runtime/engine/process:yolo_process", "@crates//:anyhow", "@crates//:serde_json", "@crates//:tokio"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)
