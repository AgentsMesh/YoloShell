load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/application/support:yolo_application_support",
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/persistence/paths:yolo_paths",
    "//core/crates/runtime/engine/process/identity:yolo_process_identity",
    "//core/crates/terminal/model:yolo_terminal_model",
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_startup_checkpoint_contract",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_startup_checkpoint_contract",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_library(
    name = "yolo_startup_checkpoint_contract_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_startup_checkpoint_contract",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS),
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)

rust_binary(
    name = "wire_fixture_emitter",
    testonly = True,
    srcs = glob(["test_support/*.rs"]),
    crate_root = "test_support/wire_fixture.rs",
    edition = "2024",
    deps = [
        ":yolo_startup_checkpoint_contract",
        "//core/crates/application/support:yolo_application_support",
        "//core/crates/crypto:yolo_crypto",
        "//core/crates/persistence/paths:yolo_paths",
        "//core/crates/terminal/model:yolo_terminal_model",
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:uuid",
    ],
)
