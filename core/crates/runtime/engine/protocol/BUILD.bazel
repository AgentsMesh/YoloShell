load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/contract:yolo_agent_contract",
    "//core/crates/agent/input:yolo_agent_input",
    "//core/crates/agent/system/control/contract:yolo_agent_control_contract",
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/terminal/model:yolo_terminal_model",
    "//core/crates/wire:yolo_wire",
    "@crates//:serde",
    "@crates//:serde_bytes",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_runtime_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_runtime_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)
