load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/transport/capnp/codec",
    "//core/crates/application/cli:yolo_cli",
    "//core/crates/runtime/engine/process:yolo_process",
    "//core/crates/transport/local/unix:yolo_local_unix",
    "//core/crates/application/broker/child/custody:yolo_broker_child_custody",
    "//core/crates/application/broker/supervision/state:yolo_broker_supervision_state",
    "//core/crates/transport/remote/broker:yolo_remote_broker",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:tokio",
    "@crates//:uuid",
    "@crates//:zeroize",
]

_TEST_DEPS = _DEPS + [
    "//core/crates/application/launch/contract:yolo_launch_contract",
    "//core/crates/application/support:yolo_application_test_fixtures",
    "@crates//:tempfile",
]

rust_library(
    name = "yolo_broker_supervision",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_broker_supervision",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_library(
    name = "test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["yolo-test-support"],
    crate_name = "yolo_broker_supervision",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

isolated_rust_test(
    name = "unit_tests",
    srcs = glob([
        "src/**/*.rs",
        "unit_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_features = [
        "yolo-unit-tests",
        "yolo-test-support",
    ],
    crate_name = "yolo_broker_supervision_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

isolated_rust_test(
    name = "integration_tests",
    srcs = glob([
        "src/**/*.rs",
        "integration_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_features = [
        "yolo-integration-tests",
        "yolo-test-support",
    ],
    crate_name = "yolo_broker_supervision_integration_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)
