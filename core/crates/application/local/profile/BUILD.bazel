load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])
_DEPS = [
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:serde",
]
filegroup(name = "architecture_check_data", srcs = glob(["**/*.rs"]) + ["BUILD.bazel"])
rust_library(
    name = "yolo_local_profile",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)
rust_test(
    name = "unit_tests",
    crate_name = "yolo_local_profile_unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["@crates//:serde_json"],
)
rust_test(
    name = "integration_tests",
    crate_name = "yolo_local_profile_integration_tests",
    srcs = glob(["integration_tests/**/*.rs"]),
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_local_profile",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)
