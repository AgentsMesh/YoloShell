load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/application/local/profile:yolo_local_profile",
    "//core/crates/build_image:yolo_build_image",
    "//core/crates/hub/client:yolo_hub_client",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/local/startup:yolo_hub_local_startup",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/state:yolo_hub_state",
    "//core/crates/persistence/paths:yolo_paths",
    "//core/crates/transport/local/unix:yolo_local_unix",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:sha2",
    "@crates//:tokio",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_local_lifecycle",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_local_lifecycle",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/**/*.rs"]),
    crate_name = "yolo_local_lifecycle_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_local_lifecycle",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)
