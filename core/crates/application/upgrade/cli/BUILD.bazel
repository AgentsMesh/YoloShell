load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/build_image:yolo_build_image",
    "//core/crates/hub/client:yolo_hub_client",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/state:yolo_hub_state",
    "//core/crates/application/local/profile:yolo_local_profile",
    "@crates//:anyhow",
    "@crates//:clap",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "@crates//:tokio",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_upgrade_cli",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_upgrade_cli",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_upgrade_cli_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["@crates//:tempfile"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs"]),
    crate_name = "yolo_upgrade_cli_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = [":yolo_upgrade_cli"],
)
