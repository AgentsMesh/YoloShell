load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/application/local/profile:yolo_local_profile",
    "//core/crates/hub/agent/run/protocol:yolo_hub_agent_run_protocol",
    "//core/crates/hub/client:yolo_hub_client",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/state:yolo_hub_state",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/hub/workspace/protocol:yolo_hub_workspace_protocol",
    "@crates//:anyhow",
    "@crates//:clap",
    "@crates//:serde_json",
    "@crates//:tokio",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_workspace_cli",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_workspace_cli",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"], allow_empty = True),
    crate_name = "yolo_workspace_cli_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"], allow_empty = True) + ["BUILD.bazel"],
)
