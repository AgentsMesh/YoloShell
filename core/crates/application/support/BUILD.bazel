load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:test_features.bzl", "TEST_SUPPORT_FEATURE", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/application/launch/contract:yolo_launch_contract",
    "//core/crates/build_image:yolo_build_image",
    "@crates//:libc",
]

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = False,
    ),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)

rust_library(
    name = "yolo_application_support",
    srcs = [":runtime_sources"],
    crate_name = "yolo_application_support",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_library(
    name = "yolo_application_support_test_support",
    testonly = True,
    srcs = [":runtime_sources"],
    crate_features = [TEST_SUPPORT_FEATURE],
    crate_name = "yolo_application_support_test_support",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_library(
    name = "yolo_application_test_fixtures",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
    crate_name = "yolo_application_test_fixtures",
    crate_root = "test_support/lib.rs",
    edition = "2024",
    deps = ["@crates//:tracing"],
)

rust_test(
    name = "yolo_application_support_unit_tests",
    srcs = [
        ":runtime_sources",
        ":unit_test_sources",
        "test_support/executables.rs",
    ],
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_application_support_unit_test",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)
