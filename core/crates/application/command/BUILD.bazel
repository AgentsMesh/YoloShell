load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/cli:yolo_agent_cli",
    "//core/crates/application/protocol/cli:yolo_protocol_cli",
    "//core/crates/application/trusted-plugin/cli:yolo_trusted_plugin_cli",
    "//core/crates/application/upgrade/cli:yolo_upgrade_cli",
    "//core/crates/application/workspace/cli:yolo_workspace_cli",
    "//core/crates/conversation/cli:yolo_conversation_cli",
    "//core/crates/hub/client:yolo_hub_client",
    "//core/crates/hub/identity:yolo_hub_identity",
    "@crates//:anyhow",
    "@crates//:clap",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_command_cli",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_command_cli",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_command_cli_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)
