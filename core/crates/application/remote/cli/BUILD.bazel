load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load(
    "//build_system/bazel/rust:test_features.bzl",
    "INTEGRATION_TEST_FEATURES",
    "SERIAL_TEST_ENVIRONMENT",
    "UNIT_TEST_FEATURES",
)

package(default_visibility = ["//visibility:public"])

_REMOTE_BINARY_ENVIRONMENT = "YOLO_REMOTE_BINARY"

_RUNTIME_DEPS = [
    "//core/crates/transport/capnp/codec",
    "//core/crates/application/cli:yolo_cli",
    "//core/crates/application/broker/startup:yolo_broker_startup",
    "//core/crates/application/broker/supervision:yolo_broker_supervision",
    "//core/crates/application/broker/supervision/state:yolo_broker_supervision_state",
    "//core/crates/application/launch/contract:yolo_launch_contract",
    "//core/crates/transport/broker/launch/authority:yolo_broker_launch_authority",
    "//core/crates/runtime/engine/process:yolo_process",
    "//core/crates/transport/remote/broker:yolo_remote_broker",
    "@crates//:anyhow",
    "@crates//:clap",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:tokio",
    "@crates//:uuid",
]

_TEST_DEPS = _RUNTIME_DEPS + [
    "//core:yolo_runtime",
    "@crates//:libc",
    "@crates//:tempfile",
]

_INTEGRATION_DEPS = _TEST_DEPS + [
    "//core/crates/transport/broker/hub/protocol:yolo_broker_hub_protocol",
    "//core/crates/transport/capnp/rpc",
    "//core/crates/application/broker/startup:test_support",
    "//core/crates/transport/client:yolo_client",
    "//core/crates/transport/remote:yolo_remote",
    "@crates//:russh",
]

_TEST_ENVIRONMENT = dict(SERIAL_TEST_ENVIRONMENT)

_TEST_ENVIRONMENT[_REMOTE_BINARY_ENVIRONMENT] = "$(rootpath //core/crates/application/yolo:yolo)"

rust_library(
    name = "yolo_remote_cli",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_remote_cli",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _RUNTIME_DEPS,
)

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = False,
    ),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(
        ["test_support/**/*.rs"],
        allow_empty = False,
    ),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(
        ["integration_tests/**/*.rs"],
        allow_empty = True,
    ),
)

isolated_rust_test(
    name = "remote_unit_tests",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
        ":unit_test_sources",
    ],
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_remote_unit_test",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = SERIAL_TEST_ENVIRONMENT,
    deps = _TEST_DEPS,
)

isolated_rust_test(
    name = "remote_integration_tests",
    srcs = [
        ":integration_test_sources",
        ":runtime_sources",
        ":test_support_sources",
    ],
    coverage_objects = ["//core/crates/application/yolo:yolo"],
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_remote_integration_test",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = _TEST_ENVIRONMENT,
    deps = _INTEGRATION_DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
