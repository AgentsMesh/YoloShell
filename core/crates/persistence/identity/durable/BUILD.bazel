load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:test_features.bzl", "INTEGRATION_TEST_FEATURES", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:thiserror",
]

rust_library(
    name = "yolo_durable_identity",
    srcs = [":runtime_sources"],
    crate_name = "yolo_durable_identity",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "yolo_durable_identity_unit_tests",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
        ":unit_test_sources",
    ],
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_durable_identity_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["@crates//:serde_json"],
)

rust_test(
    name = "yolo_durable_identity_integration_tests",
    srcs = [
        ":integration_test_sources",
        ":runtime_sources",
        ":test_support_sources",
    ],
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_durable_identity_integration_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "runtime_sources",
    srcs = glob(["src/**/*.rs"]),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(["unit_tests/**/*.rs"]),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(["integration_tests/**/*.rs"]),
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)
