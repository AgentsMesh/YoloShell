load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_paths_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_paths_core",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = ["@crates//:anyhow"],
)

rust_test(
    name = "yolo_paths_core_unit_tests",
    srcs = glob(["unit_tests/**/*.rs"]),
    crate_name = "yolo_paths_core_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = [":yolo_paths_core"],
)
