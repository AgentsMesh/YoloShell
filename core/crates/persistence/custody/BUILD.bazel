load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load("//build_system/bazel/rust:test_features.bzl", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_PROCESS_COMPONENT = "//core/crates/runtime/engine/process:yolo_process"

_PROCESS_ADVERSARIAL_COMPONENT = "//core/crates/runtime/engine/process:yolo_process_adversarial"

_PATHS_COMPONENT = "//core/crates/persistence/paths:yolo_paths"

_DEPS = [
    "//core/crates/application/support:yolo_application_support",
    "//core/crates/persistence/journal:yolo_journal",
    _PATHS_COMPONENT,
    _PROCESS_COMPONENT,
    "//core/crates/runtime/engine/pty/custody:yolo_pty_custody",
    "//core/crates/terminal/model:yolo_terminal_model",
    "@crates//:anyhow",
]

_PROCESS_REPLACED_DEPS = [dependency for dependency in _DEPS if dependency != _PROCESS_COMPONENT] + [
    _PROCESS_ADVERSARIAL_COMPONENT,
]

_TEST_DEPS = _PROCESS_REPLACED_DEPS + [
    "@crates//:portable-pty",
    "@crates//:tempfile",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_persistence_custody",
    srcs = [":runtime_sources"],
    crate_name = "yolo_persistence_custody",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

isolated_rust_test(
    name = "yolo_persistence_custody_unit_tests",
    srcs = [
        ":runtime_sources",
        ":unit_test_sources",
        ":unit_test_support_sources",
    ],
    aliases = {_PROCESS_ADVERSARIAL_COMPONENT: "yolo_process"},
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_persistence_custody_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

rust_library(
    name = "yolo_persistence_custody_resilience_support",
    testonly = True,
    srcs = [":runtime_sources"],
    aliases = {
        _PROCESS_ADVERSARIAL_COMPONENT: "yolo_process",
    },
    crate_name = "yolo_persistence_custody",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _PROCESS_REPLACED_DEPS,
)

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "unit_test_support_sources",
    testonly = True,
    srcs = glob(
        ["test_support/**/*.rs"],
        allow_empty = False,
    ),
)

rust_library(
    name = "yolo_persistence_custody_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + glob(
        ["test_support/**/*.rs"],
        allow_empty = True,
    ),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_persistence_custody",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS) + ["@crates//:tempfile"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
