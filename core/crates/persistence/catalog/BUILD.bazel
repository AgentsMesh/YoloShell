load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load(
    "//build_system/bazel/rust:test_features.bzl",
    "SERIAL_TEST_ENVIRONMENT",
    "UNIT_TEST_FEATURES",
)

package(default_visibility = ["//visibility:public"])

_EXCLUSIVE_TEST_TAGS = ["exclusive"]

_DEPS = [
    "//core/crates/application/support:yolo_application_support",
    "//core/crates/persistence/acl:yolo_private_acl",
    "//core/crates/persistence/maintenance/contract:yolo_maintenance_contract",
    "//core/crates/persistence/paths:yolo_paths",
    "//core/crates/terminal/model:yolo_terminal_model",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:rusqlite",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tracing",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_catalog",
    srcs = [":runtime_sources"],
    crate_name = "yolo_catalog",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

isolated_rust_test(
    name = "yolo_catalog_unit_tests",
    srcs = [
        ":runtime_sources",
        ":unit_test_sources",
        ":unit_test_support_sources",
    ],
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_catalog_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = SERIAL_TEST_ENVIRONMENT,
    tags = _EXCLUSIVE_TEST_TAGS,
    deps = _DEPS + [
        "//core/crates/application/support:yolo_application_support_test_support",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "unit_test_support_sources",
    testonly = True,
    srcs = glob(
        ["test_support/**/*.rs"],
        allow_empty = False,
    ),
)

rust_library(
    name = "yolo_catalog_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + glob(
        ["test_support/**/*.rs"],
        allow_empty = True,
    ),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_catalog",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS) + ["@crates//:tempfile"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs"]),
    crate_name = "yolo_catalog_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    env = SERIAL_TEST_ENVIRONMENT,
    tags = _EXCLUSIVE_TEST_TAGS,
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":yolo_catalog",
        "//core/crates/persistence/paths:yolo_paths",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
