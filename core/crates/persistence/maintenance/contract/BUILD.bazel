load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_maintenance_contract",
    srcs = ["src/lib.rs"],
    crate_name = "yolo_maintenance_contract",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = ["@crates//:anyhow"],
)

rust_test(
    name = "yolo_maintenance_contract_unit_tests",
    srcs = ["unit_tests/contract_tests.rs"],
    data = ["src/lib.rs"],
    crate_name = "yolo_maintenance_contract_unit_tests",
    edition = "2024",
    deps = [
        ":yolo_maintenance_contract",
        "@crates//:anyhow",
    ],
)
