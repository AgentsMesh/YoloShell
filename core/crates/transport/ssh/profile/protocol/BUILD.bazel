load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "@crates//:anyhow",
    "@crates//:serde",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_ssh_profile_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_ssh_profile_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob([
        "unit_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_name = "yolo_ssh_profile_protocol_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_ssh_profile_protocol",
        "@crates//:serde_json",
    ],
)
