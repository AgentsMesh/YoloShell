load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
package(default_visibility = ["//visibility:public"])
_DEPS = ["//core/crates/transport/capnp/codec", "//core/crates/transport/capnp/schema", "@crates//:capnp", "@crates//:zeroize"]
rust_library(name = "sensitive", crate_name = "yolo_capnp_sensitive", srcs = glob(["src/**/*.rs"]), crate_root = "src/lib.rs", edition = "2024", deps = _DEPS)
rust_test(name = "unit_tests", crate_name = "yolo_capnp_sensitive_tests", srcs = glob(["unit_tests/**/*.rs"]), crate_root = "unit_tests/lib.rs", edition = "2024", deps = _DEPS + [":sensitive"])
filegroup(name = "architecture_check_data", srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]) + ["BUILD.bazel"])
