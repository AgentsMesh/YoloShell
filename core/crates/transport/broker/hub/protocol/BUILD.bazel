load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "@crates//:serde",
    "@crates//:thiserror",
    "@crates//:uuid",
]

filegroup(name = "architecture_check_data", srcs = glob(["**/*.rs"]) + ["BUILD.bazel"])

rust_library(
    name = "yolo_broker_hub_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_broker_hub_protocol",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["@crates//:serde_json", "//core/crates/hub/identity:yolo_hub_identity"],
)

rust_library(
    name = "test_support",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
    crate_root = "test_support/fixtures.rs",
    crate_name = "yolo_broker_hub_test_support",
    edition = "2024",
    deps = _DEPS + [":yolo_broker_hub_protocol", "//core/crates/hub/identity:yolo_hub_identity"],
)
