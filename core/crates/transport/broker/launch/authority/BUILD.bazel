load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])
_DEPS = [
    "//core/crates/transport/capnp/codec",
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/state:yolo_hub_state",
    "//core/crates/persistence/paths:yolo_paths",
    "//core/crates/runtime/engine/process:yolo_process",
    "//core/crates/transport/local/unix:yolo_local_unix",
    "//core/crates/transport/remote/broker:yolo_remote_broker",
    "//core/crates/transport/ssh/profile/protocol:yolo_ssh_profile_protocol",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:ring",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:tokio",
    "@crates//:uuid",
    "@crates//:zeroize",
]
filegroup(name = "architecture_check_data", srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"])
rust_library(
    name = "yolo_broker_launch_authority",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_broker_launch_authority",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)
rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_broker_launch_authority_unit_tests",
    edition = "2024",
    deps = _DEPS + ["@crates//:tempfile"],
)
rust_binary(
    name = "authority_child",
    testonly = True,
    srcs = ["test_support/child.rs", "test_support/constants.rs"],
    crate_root = "test_support/child.rs",
    crate_name = "yolo_broker_launch_authority_child",
    edition = "2024",
    deps = _DEPS + [":yolo_broker_launch_authority"],
)
rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "integration_tests/lib.rs",
    crate_name = "yolo_broker_launch_authority_integration_tests",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_broker_launch_authority",
        "//build_system/coverage/profile_test_support:library",
        "@crates//:tempfile",
    ],
    data = [":authority_child"],
    env = {"YOLO_LAUNCH_AUTHORITY_CHILD": "$(rootpath :authority_child)"},
)
