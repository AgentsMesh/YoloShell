load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:test_features.bzl", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_CONTRACT = ["//core:lifecycle_deadline_contract"]

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = False,
    ),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)

rust_library(
    name = "yolo_session_timing",
    srcs = [":runtime_sources"],
    compile_data = _CONTRACT,
    crate_name = "yolo_session_timing",
    crate_root = "src/mod.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
)

rust_test(
    name = "yolo_session_timing_unit_tests",
    srcs = [
        ":runtime_sources",
        ":unit_test_sources",
    ],
    compile_data = _CONTRACT,
    crate_features = UNIT_TEST_FEATURES,
    data = [":runtime_sources"],
    crate_name = "yolo_session_timing_unit_test",
    crate_root = "src/mod.rs",
    edition = "2024",
)
