load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/application/launch/contract:yolo_launch_contract",
    "//core/crates/distribution/bundle:yolo_distribution_bundle",
    "//core/crates/distribution/publication/protocol:yolo_distribution_publication_protocol",
    "//core/crates/transport/remote:yolo_remote",
    "@crates//:anyhow",
    "@crates//:uuid",
]

_TEST_DEPS = ["//core/crates/crypto:yolo_crypto", "@crates//:serde_json", "@crates//:tokio"]

filegroup(name = "architecture_check_data", srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"])

rust_library(name = "yolo_remote_bundle", srcs = glob(["src/**/*.rs"]), crate_name = "yolo_remote_bundle", crate_root = "src/lib.rs", edition = "2024", version = YOLO_MARKETING_VERSION, deps = _DEPS)

rust_test(name = "unit_tests", srcs = glob(["unit_tests/**/*.rs", "test_support/**/*.rs"]), crate_name = "yolo_remote_bundle_unit_tests", crate_root = "unit_tests/lib.rs", edition = "2024", deps = _DEPS + _TEST_DEPS + [":yolo_remote_bundle"])

rust_test(name = "integration_tests", srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]), crate_name = "yolo_remote_bundle_integration_tests", crate_root = "integration_tests/lib.rs", edition = "2024", deps = _DEPS + _TEST_DEPS + [":yolo_remote_bundle"])

rust_library(name = "test_support", testonly = True, srcs = glob(["test_support/**/*.rs"]), crate_root = "test_support/lib.rs", crate_name = "yolo_remote_bundle_test_support", edition = "2024", deps = _DEPS + _TEST_DEPS)
rust_library(name = "broker_test_support", testonly = True, srcs = glob(["src/**/*.rs"]), crate_root = "src/lib.rs", crate_name = "yolo_remote_bundle_broker_test_support", edition = "2024", aliases = {"//core/crates/transport/remote:yolo_remote_broker_test_support": "yolo_remote"}, deps = [dep for dep in _DEPS if dep != "//core/crates/transport/remote:yolo_remote"] + ["//core/crates/transport/remote:yolo_remote_broker_test_support"])
rust_library(name = "adversarial", testonly = True, srcs = glob(["src/**/*.rs"]), crate_root = "src/lib.rs", crate_name = "yolo_remote_bundle_adversarial", edition = "2024", aliases = {"//core/crates/transport/remote:yolo_remote_adversarial": "yolo_remote"}, deps = [dep for dep in _DEPS if dep != "//core/crates/transport/remote:yolo_remote"] + ["//core/crates/transport/remote:yolo_remote_adversarial"])
