load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load("//build_system/bazel/rust:test_features.bzl", "INTEGRATION_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_COMMON_DEPS = [
    "//core/crates/transport/capnp/rpc",
    "//core/crates/transport/capnp/codec",
    "//core/crates/transport/runtime/rpc",
    "//core/crates/application/launch/contract:yolo_launch_contract",
    "//core/crates/distribution/bundle:yolo_distribution_bundle",
    "//core/crates/distribution/publication/protocol:yolo_distribution_publication_protocol",
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/persistence/acl:yolo_private_acl",
    "//core/crates/transport/local/unix:yolo_local_unix",
    "//core/crates/transport/session:yolo_session_timing",
    "@crates//:base64",
    "@crates//:hmac",
    "@crates//:libc",
    "@crates//:russh",
    "@crates//:russh-sftp",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha1",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tracing",
    "@crates//:uuid",
    "@crates//:zeroize",
]

_RUNTIME_DEPS = ["//core/crates/application/support:yolo_application_support", "//core/crates/persistence/lease:yolo_lease", "//core/crates/runtime/engine/protocol:yolo_runtime_protocol", "//core/crates/terminal/model:yolo_terminal_model", "//core/crates/transport/protocol/validation:yolo_protocol_validation", "//core/crates/wire:yolo_wire"]
_RUNTIME_TEST_DEPS = [
    dep for dep in _RUNTIME_DEPS
    if dep != "//core/crates/application/support:yolo_application_support"
] + ["//core/crates/application/support:yolo_application_support_test_support"]

_COMMON_TEST_DEPS = [
    dep for dep in _COMMON_DEPS
    if dep != "//core/crates/transport/local/unix:yolo_local_unix"
] + ["//core/crates/transport/local/unix:yolo_local_unix_test_support"]

_TEST_ALIASES = {
    "//core/crates/application/support:yolo_application_support_test_support": "yolo_application_support",
    "//core/crates/transport/local/unix:yolo_local_unix_test_support": "yolo_local_unix",
}

_DEPS = _RUNTIME_DEPS + _COMMON_DEPS

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = False,
    ),
)

rust_library(
    name = "yolo_remote",
    srcs = [":runtime_sources"],
    crate_name = "yolo_remote",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_library(
    name = "yolo_remote_adversarial",
    testonly = True,
    srcs = [":runtime_sources"],
    crate_name = "yolo_remote_adversarial",
    aliases = _TEST_ALIASES,
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _RUNTIME_TEST_DEPS + _COMMON_TEST_DEPS,
)

rust_library(
    name = "yolo_remote_broker_test_support",
    testonly = True,
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
    ],
    crate_features = ["broker-test-support"],
    crate_name = "yolo_remote",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "@crates//:futures",
        "//core/crates/transport/capnp/value",
        "@crates//:tempfile",
    ],
)

isolated_rust_test(
    name = "yolo_remote_unit_tests",
    srcs = [":unit_test_sources"],
    crate_name = "yolo_remote_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = [
        ":yolo_remote",
        "//core/crates/hub/delegation:yolo_hub_delegation",
        "//core/crates/hub/identity:yolo_hub_identity",
        "@crates//:uuid",
    ],
)

isolated_rust_test(
    name = "yolo_remote_integration_tests",
    srcs = [
        ":integration_test_sources",
        ":runtime_sources",
        ":test_support_sources",
    ],
    aliases = _TEST_ALIASES,
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_remote_integration_test",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _RUNTIME_TEST_DEPS + [
        "//core/crates/transport/runtime/rpc",
        "//core/crates/transport/capnp/rpc",
        "//core/crates/transport/capnp/codec",
        "//core/crates/application/launch/contract:yolo_launch_contract",
        "//core/crates/distribution/bundle:yolo_distribution_bundle",
        "//core/crates/distribution/publication/protocol:yolo_distribution_publication_protocol",
        "//core/crates/hub/delegation:yolo_hub_delegation",
        "//core/crates/hub/identity:yolo_hub_identity",
        "//core/crates/crypto:yolo_crypto",
        "//core/crates/persistence/acl:yolo_private_acl",
        "//core/crates/transport/local/unix:yolo_local_unix_test_support",
        "//core/crates/transport/session:yolo_session_timing",
        "@crates//:base64",
        "@crates//:futures",
        "@crates//:hmac",
        "@crates//:libc",
        "//core/crates/transport/capnp/value",
        "@crates//:russh",
        "@crates//:russh-sftp",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha1",
        "@crates//:tempfile",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:uuid",
        "@crates//:zeroize",
    ],
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(
        ["integration_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(
        ["test_support/**/*.rs"],
        allow_empty = False,
    ),
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
