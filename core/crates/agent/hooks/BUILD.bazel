load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

HOOKS_SOURCES = glob(["src/**/*.rs"])

HOOKS_TEST_SOURCES = glob(
    [
        "unit_tests/**/*.rs",
        "integration_tests/**/*.rs",
    ],
    allow_empty = True,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)

rust_library(
    name = "yolo_hooks",
    srcs = HOOKS_SOURCES,
    crate_name = "yolo_hooks",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = [
        "//core/crates/crypto:yolo_crypto",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "yolo_hooks_unit_tests",
    srcs = HOOKS_TEST_SOURCES,
    crate_name = "yolo_hooks_test",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = [
        ":yolo_hooks",
        "@crates//:serde_json",
        "@crates//:uuid",
    ],
)
