load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde_json",
]

rust_library(
    name = "yolo_agent_evidence",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_agent_evidence",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_agent_evidence_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["@crates//:tempfile"],
)

rust_library(
    name = "yolo_agent_evidence_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_agent_evidence",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS),
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)
