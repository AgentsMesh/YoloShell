load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/contract:yolo_agent_contract",
    "//core/crates/agent/system/adapter/contract:yolo_agent_adapter_contract",
    "//core/crates/agent/system/binding/io:yolo_agent_binding_io",
    "//core/crates/agent/system/authority/contract:yolo_agent_authority_contract",
    "//core/crates/agent/system/authority/generation:yolo_agent_hook_generation",
    "//core/crates/agent/system/core:yolo_agent_core",
    "//core/crates/agent/system/hooks/codec:yolo_hook_codec",
    "//core/crates/agent/system/hooks/runtime:yolo_hooks_runtime",
    "//core/crates/agent/system/process:yolo_agent_process",
    "//core/crates/agent/system/provider/runtime:yolo_agent_provider_runtime",
    "//core/crates/persistence/paths:yolo_paths",
    "//core/crates/runtime/engine/process:yolo_process",
    "//core/crates/transport/local/unix:yolo_local_unix",
    "//core/crates/wire:yolo_wire",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:tokio",
    "@crates//:tracing",
    "@crates//:uuid",
    "//core/crates/crypto:yolo_crypto",
]

rust_library(
    name = "yolo_hook_ingress",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hook_ingress",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"], allow_empty = True),
    crate_name = "yolo_hook_ingress_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    deps = component_test_dependencies(_DEPS) + [
        "//core/crates/agent/providers/gemini/hooks:yolo_gemini_hooks",
        "//core/crates/agent/providers/gemini/provider:yolo_gemini_identity",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "yolo_hook_ingress_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hook_ingress",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    deps = component_test_dependencies(_DEPS),
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"],
)
