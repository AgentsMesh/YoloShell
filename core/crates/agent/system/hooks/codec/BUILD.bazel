load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/contract:yolo_agent_contract",
    "//core/crates/agent/runtime:yolo_agent_runtime",
    "//core/crates/agent/system/hooks/runtime:yolo_hooks_runtime",
    "@crates//:anyhow",
    "@crates//:serde_json",
]

rust_library(
    name = "yolo_hook_codec",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hook_codec",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)


filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"],
)
