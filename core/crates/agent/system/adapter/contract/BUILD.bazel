load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "yolo_agent_adapter_contract",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_agent_adapter_contract",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = [
        "//core/crates/agent/contract:yolo_agent_contract",
        "//core/crates/terminal/metadata/protocol:yolo_terminal_metadata_protocol",
        "@crates//:anyhow",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "yolo_agent_adapter_contract_unit_tests",
    srcs = glob([
        "src/**/*.rs",
        "unit_tests/**/*.rs",
    ]),
    crate_name = "yolo_agent_adapter_contract_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//core/crates/agent/contract:yolo_agent_contract",
        "//core/crates/terminal/metadata/protocol:yolo_terminal_metadata_protocol",
        "@crates//:anyhow",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:uuid",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)
