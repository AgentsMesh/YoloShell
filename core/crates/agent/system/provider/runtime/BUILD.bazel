load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/contract:yolo_agent_contract",
    "//core/crates/agent/system/adapter/contract:yolo_agent_adapter_contract",
    "//core/crates/agent/system/hooks/codec:yolo_hook_codec",
    "//core/crates/agent/system/hooks/installation/contract:yolo_hook_installation_contract",
    "//core/crates/agent/system/provider/contract:yolo_agent_provider_contract",
    "//core/crates/conversation/source:yolo_conversation_source",
    "@crates//:anyhow",
    "@crates//:thiserror",
]

rust_library(
    name = "yolo_agent_provider_runtime",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_agent_provider_runtime",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_agent_provider_runtime_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)
