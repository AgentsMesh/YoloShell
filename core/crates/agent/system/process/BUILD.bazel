load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load("//build_system/bazel/rust:test_features.bzl", "INTEGRATION_TEST_FEATURES", "UNIT_TEST_FEATURE")

package(default_visibility = ["//visibility:public"])

_PROCESS_COMPONENT = "//core/crates/runtime/engine/process:yolo_process"

_PROCESS_TEST_SUPPORT = "//core/crates/runtime/engine/process:yolo_process_adversarial"

_DEPS = [
    "//core/crates/agent/contract:yolo_agent_contract",
    "//core/crates/agent/system/core:yolo_agent_core",
    _PROCESS_COMPONENT,
    "@crates//:anyhow",
    "@crates//:libc",
]

_TEST_DEPS = [dependency for dependency in _DEPS if dependency != _PROCESS_COMPONENT] + [
    _PROCESS_TEST_SUPPORT,
    "//core/crates/agent/providers/claude:yolo_claude",
    "//core/crates/agent/providers/codex:yolo_codex",
    "//core/crates/agent/providers/codex/hooks:yolo_codex_hooks",
    "@crates//:tempfile",
]

rust_library(
    name = "yolo_agent_process",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_agent_process",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

isolated_rust_test(
    name = "yolo_agent_process_integration_tests",
    srcs = [
        ":integration_test_sources",
        ":runtime_sources",
    ],
    aliases = {_PROCESS_TEST_SUPPORT: "yolo_process"},
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_agent_process_integration_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

isolated_rust_test(
    name = "yolo_agent_process_unit_tests",
    srcs = [":runtime_sources", ":unit_test_sources", ":test_support_sources"],
    aliases = {_PROCESS_TEST_SUPPORT: "yolo_process"},
    crate_features = [UNIT_TEST_FEATURE],
    crate_name = "yolo_agent_process_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
)

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = False,
    ),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(
        ["integration_tests/**/*.rs"],
        allow_empty = True,
    ),
)

rust_library(
    name = "yolo_agent_process_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + glob(
        ["test_support/**/*.rs"],
        allow_empty = True,
    ),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_agent_process",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS) + ["@crates//:tempfile"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
