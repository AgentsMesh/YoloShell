load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:test_features.bzl", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/contract:yolo_agent_contract",
    "//core/crates/agent/system/adapter/contract:yolo_agent_adapter_contract",
    "//core/crates/agent/system/core:yolo_agent_core",
    "//core/crates/agent/system/providers:yolo_agent_providers",
    "//core/crates/terminal/model:yolo_terminal_model",
    "@crates//:anyhow",
    "@crates//:serde",
]

rust_library(
    name = "yolo_agent_launch",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_agent_launch",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob([
        "src/**/*.rs",
        "unit_tests/**/*.rs",
    ]),
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_agent_launch_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/agent/providers/claude:yolo_claude",
        "//core/crates/agent/providers/codex:yolo_codex",
        "//core/crates/application/support:yolo_application_support",
        "@crates//:tempfile",
        "@crates//:uuid",
    ],
)

rust_library(
    name = "yolo_agent_launch_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_agent_launch",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS),
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)
