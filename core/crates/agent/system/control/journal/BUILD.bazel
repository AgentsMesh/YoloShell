load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:uuid",
]
_TEST_DEPS = ["@crates//:serde_json", "@crates//:tempfile"]
_UNIT_DEPS = [dep for dep in _DEPS if dep != "//core/crates/persistence/paths:yolo_paths"] + [
    "//core/crates/persistence/paths:yolo_paths_persistence_test_support",
]

rust_library(
    name = "yolo_agent_control_journal",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_agent_control_journal",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_agent_control_journal_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _UNIT_DEPS + _TEST_DEPS,
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_agent_control_journal_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + _TEST_DEPS + [":yolo_agent_control_journal"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_agent_control_journal_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_agent_control_journal",
    crate_root = "src/lib.rs",
    edition = "2024",
    crate_features = COMPONENT_TEST_FEATURES,
    aliases = component_test_aliases(_DEPS),
    deps = component_test_dependencies(_DEPS),
)
