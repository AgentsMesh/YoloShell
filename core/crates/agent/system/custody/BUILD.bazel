load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load(
    "//build_system/bazel/rust:claude_custody_component_deps.bzl",
    "CUSTODY_DEPS",
    "CUSTODY_RESILIENCE_DEPS",
    "CUSTODY_UNIT_TEST_DEPS",
    "CUSTODY_UNIT_TEST_ALIASES",
    "PERSISTENCE_CUSTODY_RESILIENCE_SUPPORT",
    "PROCESS_TEST_SUPPORT",
)
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load("//build_system/bazel/rust:test_features.bzl", "INTEGRATION_TEST_FEATURES", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_RUNTIME_SOURCES = glob(["src/**/*.rs"])

rust_library(
    name = "yolo_claude_custody",
    srcs = _RUNTIME_SOURCES,
    crate_name = "yolo_claude_custody",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = CUSTODY_DEPS,
)

isolated_rust_test(
    name = "yolo_claude_custody_unit_tests",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
        ":unit_test_sources",
    ],
    aliases = CUSTODY_UNIT_TEST_ALIASES,
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_claude_custody_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = CUSTODY_UNIT_TEST_DEPS,
)

rust_library(
    name = "yolo_claude_custody_resilience_support",
    testonly = True,
    srcs = _RUNTIME_SOURCES + glob(["test_support/**/*.rs"]),
    aliases = {
        PROCESS_TEST_SUPPORT: "yolo_process",
        PERSISTENCE_CUSTODY_RESILIENCE_SUPPORT: "yolo_persistence_custody",
    },
    crate_features = ["adversarial-test-hooks"],
    crate_name = "yolo_claude_custody",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = CUSTODY_RESILIENCE_DEPS,
)

isolated_rust_test(
    name = "yolo_claude_custody_integration_tests",
    srcs = [":runtime_sources", ":test_support_sources", ":integration_test_sources"],
    aliases = CUSTODY_UNIT_TEST_ALIASES,
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_claude_custody_integration_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = CUSTODY_UNIT_TEST_DEPS,
)

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = False,
    ),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(
        ["integration_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(
        ["test_support/**/*.rs"],
        allow_empty = False,
    ),
)

rust_library(
    name = "yolo_claude_custody_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + glob(
        ["test_support/**/*.rs"],
        allow_empty = True,
    ),
    aliases = component_test_aliases(CUSTODY_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_claude_custody",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(CUSTODY_DEPS) + ["@crates//:tempfile"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
