load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load("//build_system/bazel/rust:test_features.bzl", "INTEGRATION_TEST_FEATURES", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_CLAUDE_COMPONENT = "//core/crates/agent/providers/claude:yolo_claude"

_CLAUDE_RESILIENCE_COMPONENT = "//core/crates/agent/providers/claude:yolo_claude_resilience_support"

_PROCESS_COMPONENT = "//core/crates/runtime/engine/process:yolo_process"

_PROCESS_TEST_SUPPORT = "//core/crates/runtime/engine/process:yolo_process_adversarial"

_PATHS_COMPONENT = "//core/crates/persistence/paths:yolo_paths"

_PATHS_TEST_SUPPORT = "//core/crates/persistence/paths:yolo_paths_persistence_test_support"

_CLAUDE_STORE_TEST_SUPPORT = "//core/crates/agent/providers/claude:yolo_claude_store_test_support"

_RUNTIME_SOURCES = glob(["src/**/*.rs"])

_DEPS = [
    _CLAUDE_COMPONENT,
    "//core/crates/agent/providers/claude/hooks/contract:yolo_claude_hook_contract",
    "//core/crates/crypto:yolo_crypto",
    _PATHS_COMPONENT,
    _PROCESS_COMPONENT,
    "//core/crates/wire:yolo_wire",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:tokio",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_claude_hooks",
    srcs = _RUNTIME_SOURCES,
    crate_name = "yolo_claude_hooks",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

_TEST_DEPS = [
    dependency
    for dependency in _DEPS
    if dependency != _PROCESS_COMPONENT
] + [
    _PROCESS_TEST_SUPPORT,
    "@crates//:tempfile",
]

isolated_rust_test(
    name = "yolo_claude_hooks_unit_tests",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
        ":unit_test_sources",
    ],
    aliases = {_PROCESS_TEST_SUPPORT: "yolo_process"},
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_claude_hooks_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

isolated_rust_test(
    name = "yolo_claude_hooks_integration_tests",
    srcs = [":runtime_sources", ":test_support_sources", ":integration_test_sources"],
    aliases = {_PROCESS_TEST_SUPPORT: "yolo_process"},
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_claude_hooks_integration_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

rust_library(
    name = "yolo_claude_hooks_resilience_support",
    testonly = True,
    srcs = _RUNTIME_SOURCES,
    aliases = {
        _CLAUDE_RESILIENCE_COMPONENT: "yolo_claude",
        _PROCESS_TEST_SUPPORT: "yolo_process",
    },
    crate_features = ["adversarial-test-hooks"],
    crate_name = "yolo_claude_hooks",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = [
        dependency
        for dependency in _DEPS
        if dependency not in [
            _CLAUDE_COMPONENT,
            _PROCESS_COMPONENT,
        ]
    ] + [
        _CLAUDE_RESILIENCE_COMPONENT,
        _PROCESS_TEST_SUPPORT,
    ],
)

rust_library(
    name = "yolo_claude_hooks_store_test_support",
    testonly = True,
    srcs = _RUNTIME_SOURCES,
    aliases = {
        _CLAUDE_STORE_TEST_SUPPORT: "yolo_claude",
        _PATHS_TEST_SUPPORT: "yolo_paths",
    },
    crate_name = "yolo_claude_hooks",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        dependency
        for dependency in _DEPS
        if dependency not in [
            _CLAUDE_COMPONENT,
            _PATHS_COMPONENT,
        ]
    ] + [
        _CLAUDE_STORE_TEST_SUPPORT,
        _PATHS_TEST_SUPPORT,
    ],
)

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = False,
    ),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(
        ["integration_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
)

rust_library(
    name = "yolo_claude_hooks_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + glob(
        ["test_support/**/*.rs"],
        allow_empty = True,
    ),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_claude_hooks",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS) + ["@crates//:tempfile"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
