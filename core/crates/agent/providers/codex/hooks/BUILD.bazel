load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load(
    "//build_system/bazel/rust:test_features.bzl",
    "INTEGRATION_TEST_FEATURES",
    "SERIAL_TEST_ENVIRONMENT",
    "UNIT_TEST_FEATURES",
)

package(default_visibility = ["//visibility:public"])

_APPLICATION_SUPPORT = "//core/crates/application/support:yolo_application_support"

_APPLICATION_TEST_SUPPORT = "//core/crates/application/support:yolo_application_support_test_support"

_PATHS_COMPONENT = "//core/crates/persistence/paths:yolo_paths"

_PATHS_TEST_SUPPORT = "//core/crates/persistence/paths:yolo_paths_persistence_test_support"

_PROCESS_COMPONENT = "//core/crates/runtime/engine/process:yolo_process"

_PROCESS_TEST_SUPPORT = "//core/crates/runtime/engine/process:yolo_process_adversarial"

_DEPS = [
    "//core/crates/transport/capnp/codec",
    "//core/crates/build_image:yolo_build_image",
    "//core/crates/agent/providers/codex:yolo_codex",
    "//core/crates/agent/providers/codex/hooks/contract:yolo_codex_hook_contract",
    "//core/crates/agent/system/hooks/runtime:yolo_hooks_runtime",
    _APPLICATION_SUPPORT,
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/persistence/acl:yolo_private_acl",
    _PATHS_COMPONENT,
    _PROCESS_COMPONENT,
    "//core/crates/transport/local/unix:yolo_local_unix",
    "//core/crates/transport/session:yolo_session_timing",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:ring",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "@crates//:tokio",
    "@crates//:tracing",
    "@crates//:uuid",
]

_TEST_ALIASES = {
    _APPLICATION_TEST_SUPPORT: "yolo_application_support",
    _PATHS_TEST_SUPPORT: "yolo_paths",
    _PROCESS_TEST_SUPPORT: "yolo_process",
}

_TEST_DEPS = [
    dependency
    for dependency in _DEPS
    if dependency not in [
        _APPLICATION_SUPPORT,
        _PATHS_COMPONENT,
        _PROCESS_COMPONENT,
    ]
] + [
    _APPLICATION_TEST_SUPPORT,
    _PATHS_TEST_SUPPORT,
    _PROCESS_TEST_SUPPORT,
    "@crates//:tempfile",
]

rust_library(
    name = "yolo_codex_hooks",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_codex_hooks",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_library(
    name = "yolo_codex_hooks_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = {_PATHS_TEST_SUPPORT: "yolo_paths"},
    crate_features = ["yolo-test-support"],
    crate_name = "yolo_codex_hooks",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        dependency
        for dependency in _DEPS
        if dependency != _PATHS_COMPONENT
    ] + [_PATHS_TEST_SUPPORT],
)

isolated_rust_test(
    name = "yolo_codex_hooks_unit_tests",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
        ":unit_test_sources",
    ],
    aliases = _TEST_ALIASES,
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_codex_hooks_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = SERIAL_TEST_ENVIRONMENT,
    deps = _TEST_DEPS,
)

isolated_rust_test(
    name = "yolo_codex_hooks_integration_tests",
    srcs = [
        ":integration_test_sources",
        ":runtime_sources",
        ":test_support_sources",
    ],
    aliases = _TEST_ALIASES,
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_codex_hooks_integration_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = False,
    ),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(
        ["integration_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
)

rust_library(
    name = "yolo_codex_hooks_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + glob(
        ["test_support/**/*.rs"],
        allow_empty = True,
    ),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_codex_hooks",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS) + ["@crates//:tempfile"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
