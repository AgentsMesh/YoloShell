load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:component_test_graph.bzl", "COMPONENT_TEST_FEATURES", "component_test_aliases", "component_test_dependencies")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load("//build_system/bazel/rust:test_features.bzl", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_RUNTIME_SOURCES = glob(["src/**/*.rs"])

_DETECTION_TEST_SUPPORT = "//core/crates/agent/system/detection:yolo_agent_detection_adversarial"

_PATHS_COMPONENT = "//core/crates/persistence/paths:yolo_paths"

_PATHS_TEST_SUPPORT = "//core/crates/persistence/paths:yolo_paths_persistence_test_support"

_DEPS = [
    "//core/crates/agent/contract:yolo_agent_contract",
    "//core/crates/agent/system/adapter/contract:yolo_agent_adapter_contract",
    "//core/crates/agent/system/core:yolo_agent_core",
    "//core/crates/agent/system/authority/contract:yolo_agent_authority_contract",
    "//core/crates/agent/providers/codex/hooks/contract:yolo_codex_hook_contract",
    "//core/crates/agent/providers/codex/provider:yolo_codex_identity",
    "//core/crates/crypto:yolo_crypto",
    _PATHS_COMPONENT,
    "//core/crates/terminal/model:yolo_terminal_model",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_codex",
    srcs = _RUNTIME_SOURCES,
    crate_name = "yolo_codex",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

isolated_rust_test(
    name = "yolo_codex_unit_tests",
    srcs = [
        ":runtime_sources",
        ":test_support_sources",
        ":unit_test_sources",
    ],
    aliases = {_DETECTION_TEST_SUPPORT: "yolo_agent_detection"},
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_codex_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        _DETECTION_TEST_SUPPORT,
        "//core/crates/agent/system/providers:yolo_agent_providers",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "yolo_codex_resilience_support",
    testonly = True,
    srcs = _RUNTIME_SOURCES + glob(["test_support/**/*.rs"]),
    crate_features = ["adversarial-test-hooks"],
    crate_name = "yolo_codex",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_library(
    name = "yolo_codex_store_test_support",
    testonly = True,
    srcs = _RUNTIME_SOURCES,
    aliases = {_PATHS_TEST_SUPPORT: "yolo_paths"},
    crate_name = "yolo_codex",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        dependency
        for dependency in _DEPS
        if dependency != _PATHS_COMPONENT
    ] + [_PATHS_TEST_SUPPORT],
)

filegroup(
    name = "runtime_sources",
    srcs = glob(
        ["src/**/*.rs"],
        allow_empty = False,
    ),
)

filegroup(
    name = "unit_test_sources",
    testonly = True,
    srcs = glob(
        ["unit_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "integration_test_sources",
    testonly = True,
    srcs = glob(
        ["integration_tests/**/*.rs"],
        allow_empty = True,
    ),
)

filegroup(
    name = "test_support_sources",
    testonly = True,
    srcs = glob(
        ["test_support/**/*.rs"],
        allow_empty = False,
    ),
)

rust_library(
    name = "yolo_codex_component_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + glob(
        ["test_support/**/*.rs"],
        allow_empty = True,
    ),
    aliases = component_test_aliases(_DEPS),
    crate_features = COMPONENT_TEST_FEATURES,
    crate_name = "yolo_codex",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = component_test_dependencies(_DEPS) + ["@crates//:tempfile"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)
