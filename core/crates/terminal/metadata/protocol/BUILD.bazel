load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "yolo_terminal_metadata_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_terminal_metadata_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = ["@crates//:serde"],
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_terminal_metadata_protocol_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = [":yolo_terminal_metadata_protocol", "@crates//:serde_json"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)
