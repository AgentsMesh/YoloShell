load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/routing:yolo_hub_routing",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "//core/crates/hub/agent/run/protocol:yolo_hub_agent_run_protocol",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/hub/workspace/protocol:yolo_hub_workspace_protocol",
    "//core/crates/hub/transport:yolo_hub_transport",
    "//core/crates/transport/capnp/codec",
    "//core/crates/crypto:yolo_crypto",
    "@crates//:serde",
    "@crates//:ring",
    "@crates//:uuid",
    "@crates//:thiserror",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        [
            "src/**/*.rs",
            "unit_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "test_support",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
    crate_name = "yolo_hub_peer_protocol_test_support",
    crate_root = "test_support/fixtures.rs",
    edition = "2024",
    deps = _DEPS + [":yolo_hub_peer_protocol", "//core/crates/hub/delegation:test_support"],
)

rust_library(
    name = "yolo_hub_peer_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_peer_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(
        [
            "unit_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ),
    crate_name = "yolo_hub_peer_protocol_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_peer_protocol",
        ":test_support",
        "//core/crates/hub/delegation:test_support",
        "//core/crates/hub/management/protocol:yolo_hub_management_protocol",
        "//core/crates/hub/federation/settings:yolo_hub_federation_settings",
        "@crates//:serde_json",
    ],
)
