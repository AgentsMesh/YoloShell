load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "@crates//:russh",
    "@crates//:tokio",
    "@crates//:anyhow",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        [
            "src/**/*.rs",
            "unit_tests/**/*.rs",
            "integration_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_peer_transport",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_peer_transport",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_hub_peer_transport_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "integration_tests",
    srcs = glob(
        [
            "integration_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ),
    crate_name = "yolo_hub_peer_transport_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_peer_transport",
        "//core/crates/hub/identity:yolo_hub_identity",
        "@crates//:ring",
    ],
)
