load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/federation/settings:yolo_hub_federation_settings",
    "//core/crates/hub/peer/io:yolo_hub_peer_io",
    "@crates//:anyhow",
    "@crates//:tokio",
]

_TEST_DEPS = [
    "//core/crates/hub/identity:yolo_hub_identity",
    "@crates//:ring",
]

filegroup(name = "architecture_check_data", srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"])

rust_library(name = "yolo_hub_peer_dialer", srcs = glob(["src/**/*.rs"]), crate_name = "yolo_hub_peer_dialer", crate_root = "src/lib.rs", edition = "2024", version = YOLO_MARKETING_VERSION, deps = _DEPS)

rust_test(name = "unit_tests", srcs = glob(["unit_tests/**/*.rs", "test_support/**/*.rs"]), crate_name = "yolo_hub_peer_dialer_unit_tests", crate_root = "unit_tests/lib.rs", edition = "2024", deps = _DEPS + _TEST_DEPS + [":yolo_hub_peer_dialer"])
