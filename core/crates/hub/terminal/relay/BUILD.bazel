load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "//core/crates/hub/client:yolo_hub_client",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/relay/control/protocol:yolo_hub_relay_control_protocol",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/hub/terminal/client:yolo_hub_terminal_client",
    "@crates//:tokio",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_terminal_relay",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_terminal_relay",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob([
        "src/**/*.rs",
        "unit_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_name = "yolo_hub_terminal_relay_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/hub/jsonrpc/transport:yolo_hub_jsonrpc_transport",
        "//core/crates/hub/jsonrpc/protocol:yolo_hub_jsonrpc_protocol",
    "//core/crates/hub/terminal/wire:yolo_hub_terminal_wire",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob([
        "integration_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_name = "yolo_hub_terminal_relay_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_terminal_relay",
        "//core/crates/hub/jsonrpc/transport:yolo_hub_jsonrpc_transport",
        "//core/crates/hub/jsonrpc/protocol:yolo_hub_jsonrpc_protocol",
    "//core/crates/hub/terminal/wire:yolo_hub_terminal_wire",
        "@crates//:tempfile",
    ],
)
