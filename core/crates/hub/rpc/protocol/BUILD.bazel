load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:lifecycle_deadline_contract.bzl", "hub_lifecycle_deadline_rust_contract")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:source_paths.bzl", "canonical_source_path_flags")

package(default_visibility = ["//visibility:public"])

hub_lifecycle_deadline_rust_contract(name = "hub_lifecycle_deadline_contract")

_SOURCES = glob(["src/**/*.rs"])

_DEPS = [
    "//core/crates/conversation/protocol:yolo_conversation_protocol",
    "//core/crates/presentation/protocol:yolo_presentation_protocol",
    "//core/crates/hub/client/access/protocol:yolo_hub_client_access_protocol",
    "//core/crates/hub/remote/setup/protocol:yolo_hub_remote_setup_protocol",
    "//core/crates/transport/broker/hub/protocol:yolo_broker_hub_protocol",
    "//core/crates/transport/ssh/profile/protocol:yolo_ssh_profile_protocol",
    "//core/crates/hub/ssh/profile/protocol:yolo_hub_ssh_profile_protocol",
    "//core/crates/hub/build/protocol:yolo_hub_build_protocol",
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "//core/crates/hub/enrollment/protocol:yolo_hub_enrollment_protocol",
    "//core/crates/hub/agent/run/protocol:yolo_hub_agent_run_protocol",
    "//core/crates/hub/events/protocol:yolo_hub_events_protocol",
    "//core/crates/hub/file/protocol:yolo_hub_file_protocol",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/management/protocol:yolo_hub_management_protocol",
    "//core/crates/hub/routing:yolo_hub_routing",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/hub/workspace/protocol:yolo_hub_workspace_protocol",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        [
            "src/**/*.rs",
            "unit_tests/**/*.rs",
            "integration_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ) + ["BUILD.bazel", ":hub_lifecycle_deadline_contract"],
)

rust_library(
    name = "yolo_hub_rpc_protocol",
    srcs = _SOURCES,
    compile_data = [":hub_lifecycle_deadline_contract"],
    crate_name = "yolo_hub_rpc_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = canonical_source_path_flags(_SOURCES),
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_library(
    name = "test_support",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
    crate_name = "yolo_hub_rpc_protocol_test_support",
    crate_root = "test_support/lib.rs",
    edition = "2024",
    deps = _DEPS + [":yolo_hub_rpc_protocol"],
)

rust_test(
    name = "unit_tests",
    srcs = glob(
        [
            "unit_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ),
    crate_name = "yolo_hub_rpc_protocol_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_rpc_protocol",
        "//core/crates/build_image:yolo_build_image",
        "//core/crates/hub/delegation:yolo_hub_delegation",
        "//core/crates/hub/federation/settings:yolo_hub_federation_settings",
        "//core/crates/transport/session:yolo_session_timing",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob([
        "integration_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_name = "yolo_hub_rpc_protocol_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_rpc_protocol",
        "//core/crates/hub/jsonrpc/protocol:yolo_hub_jsonrpc_protocol",
        "//core/crates/hub/jsonrpc/transport:yolo_hub_jsonrpc_transport",
    ],
)
