load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/federation/directory:yolo_hub_federation_directory",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/peer/protocol:yolo_hub_peer_protocol",
    "//core/crates/hub/routing:yolo_hub_routing",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:serde_json",
]

_TEST_DEPS = _DEPS + [
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "//core/crates/hub/federation/settings:yolo_hub_federation_settings",
    "//core/crates/hub/peer/protocol:test_support",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "@crates//:tempfile",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel", "README.md"],
)

rust_library(
    name = "yolo_hub_observation_store",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_observation_store",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_observation_store_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_observation_store_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS + [":yolo_hub_observation_store"],
)
