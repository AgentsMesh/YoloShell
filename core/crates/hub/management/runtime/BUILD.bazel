load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:test_features.bzl", "INTEGRATION_TEST_FEATURES", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/configuration/store:yolo_hub_configuration_store",
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/persistence/paths:yolo_paths",
    "//core/crates/hub/dispatch:yolo_hub_dispatch",
    "//core/crates/hub/federation:yolo_hub_federation",
    "//core/crates/hub/federation/settings:yolo_hub_federation_settings",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/local/backend:yolo_hub_local_backend",
    "//core/crates/hub/management/protocol:yolo_hub_management_protocol",
    "//core/crates/hub/peer/dialer:yolo_hub_peer_dialer",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/hub/state:yolo_hub_state",
    "@crates//:anyhow",
    "@crates//:tokio",
    "@crates//:tracing",
]

rust_library(
    name = "yolo_hub_management_runtime",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_management_runtime",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob([
        "src/**/*.rs",
        "unit_tests/**/*.rs",
    ]),
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "yolo_hub_management_runtime_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/build_image:yolo_build_image",
        "//core/crates/hub/build/protocol:yolo_hub_build_protocol",
        "@crates//:tempfile",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob([
        "src/**/*.rs",
        "integration_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_features = INTEGRATION_TEST_FEATURES,
    crate_name = "yolo_hub_management_runtime_integration_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)
