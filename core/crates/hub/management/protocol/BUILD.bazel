load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/federation/settings:yolo_hub_federation_settings",
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_hub_management_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_management_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob([
        "src/**/*.rs",
        "unit_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_name = "yolo_hub_management_protocol_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/hub/identity:yolo_hub_identity",
        "@crates//:serde_json",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)
