load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/routing:yolo_hub_routing",
    "//core/crates/transport/capnp/codec",
    "//core/crates/crypto:yolo_crypto",
    "@crates//:serde",
    "@crates//:ring",
    "@crates//:uuid",
    "@crates//:thiserror",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        [
            "src/**/*.rs",
            "unit_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "test_support",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
    crate_name = "yolo_hub_delegation_test_support",
    crate_root = "test_support/mod.rs",
    edition = "2024",
    deps = _DEPS + [":yolo_hub_delegation"],
)

rust_library(
    name = "yolo_hub_delegation",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_delegation",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(
        [
            "unit_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ),
    crate_name = "yolo_hub_delegation_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_delegation",
        "@crates//:serde_json",
    ],
)
