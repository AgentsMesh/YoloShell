load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/transport/capnp/codec",
    "@crates//:base64",
    "@crates//:ring",
    "@crates//:serde",
    "@crates//:thiserror",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_enrollment_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_enrollment_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/**/*.rs"]),
    crate_name = "yolo_hub_enrollment_protocol_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [":yolo_hub_enrollment_protocol"],
)
