load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/federation/settings:yolo_hub_federation_settings",
    "//core/crates/hub/management/protocol:yolo_hub_management_protocol",
    "//core/crates/transport/remote/provisioning/protocol:yolo_remote_provisioning_protocol",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:serde",
]

rust_library(
    name = "yolo_hub_enrollment_store",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_hub_enrollment_store",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "unit_tests/lib.rs",
    crate_name = "yolo_hub_enrollment_store_unit_tests",
    edition = "2024",
    deps = _DEPS + [":yolo_hub_enrollment_store", "//core/crates/hub/remote/startup/protocol:test_support", "@crates//:uuid", "@crates//:serde_json"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "integration_tests/lib.rs",
    crate_name = "yolo_hub_enrollment_store_integration_tests",
    edition = "2024",
    deps = _DEPS + [":yolo_hub_enrollment_store", "//core/crates/hub/remote/startup/protocol:test_support", "@crates//:uuid", "@crates//:serde_json", "@crates//:tempfile"],
)

filegroup(name = "architecture_check_data", srcs = glob(["**/*.rs"]) + ["BUILD.bazel"])
