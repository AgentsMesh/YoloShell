load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/events/protocol:yolo_hub_events_protocol",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "@crates//:tokio",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_hub_events_bus",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_events_bus",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_hub_events_bus_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/hub/identity:yolo_hub_identity",
        "//core/crates/presentation/protocol:yolo_presentation_protocol",
        "@crates//:serde_json",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]) + ["BUILD.bazel"],
)
