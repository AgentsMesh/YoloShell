load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/client/access/protocol:yolo_hub_client_access_protocol",
    "//core/crates/hub/identity:yolo_hub_identity",
    "@crates//:thiserror",
    "@crates//:tokio",
]

_TEST_DEPS = _DEPS + [
    "//core/crates/hub/routing:yolo_hub_routing",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_client_access_registry",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_client_access_registry",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_client_access_registry_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS,
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_client_access_registry_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _TEST_DEPS + [":yolo_hub_client_access_registry"],
)
