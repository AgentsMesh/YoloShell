load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/client/access/protocol:yolo_hub_client_access_protocol",
    "//core/crates/hub/client/access/registry:yolo_hub_client_access_registry",
    "//core/crates/hub/identity:yolo_hub_identity",
    "@crates//:anyhow",
    "@crates//:russh",
    "@crates//:tokio",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob([
        "src/**/*.rs",
        "unit_tests/**/*.rs",
        "integration_tests/**/*.rs",
        "test_support/**/*.rs",
    ]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_client_transport",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_client_transport",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_hub_client_transport_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_client_transport_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_client_transport",
        "//core/crates/hub/routing:yolo_hub_routing",
        "@crates//:ring",
    ],
)
