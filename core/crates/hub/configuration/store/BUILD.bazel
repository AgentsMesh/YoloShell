load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/federation/settings:yolo_hub_federation_settings",
    "//core/crates/hub/management/protocol:yolo_hub_management_protocol",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_hub_configuration_store",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_configuration_store",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob([
        "src/**/*.rs",
        "unit_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_name = "yolo_hub_configuration_store_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/hub/identity:yolo_hub_identity",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob([
        "integration_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_name = "yolo_hub_configuration_store_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_configuration_store",
        "//core/crates/hub/identity:yolo_hub_identity",
        "//core/crates/hub/state:yolo_hub_state",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)
