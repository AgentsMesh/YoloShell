load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/relay/native/protocol:yolo_native_relay_schema",
    "@crates//:capnp",
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "//core/crates/hub/identity:yolo_hub_identity",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_hub_relay_control_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_relay_control_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_relay_control_protocol_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [":yolo_hub_relay_control_protocol"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_relay_control_protocol_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [":yolo_hub_relay_control_protocol"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel", "WIRE.md"],
)
