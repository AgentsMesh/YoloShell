load("@rules_rust//rust:defs.bzl", "rust_static_library", "rust_test")
package(default_visibility = ["//visibility:public"])
_DEPS = [
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/relay/control/protocol:yolo_hub_relay_control_protocol",
    "//core/crates/runtime/engine/startup/guard:yolo_startup_guard",
    "@crates//:uuid",
]
rust_static_library(
    name = "native",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_native_relay_bridge",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)
cc_library(
    name = "YoloNativeRelay",
    hdrs = ["include/yolo_native_relay.h", "include/module.modulemap"],
    includes = ["include"],
    tags = ["swift_module=YoloNativeRelay"],
    deps = [":native"],
)
rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_native_relay_bridge_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)
filegroup(name = "architecture_check_data", srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "include/*"]) + ["BUILD.bazel"])
