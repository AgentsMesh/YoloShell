load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/connector/jsonrpc:yolo_hub_connector_jsonrpc",
    "//core/crates/hub/jsonrpc/protocol:yolo_hub_jsonrpc_protocol",
    "//core/crates/hub/connector/protocol:yolo_hub_connector_protocol",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/jsonrpc/transport:yolo_hub_jsonrpc_transport",
    "//core/crates/transport/local/unix:yolo_local_unix",
    "@crates//:libc",
    "@crates//:tokio",
]

filegroup(name = "architecture_check_data", srcs = glob(["**/*.rs"]) + ["BUILD.bazel"])

rust_library(
    name = "yolo_hub_connector_client",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_hub_connector_client",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_hub_connector_client_unit_tests",
    edition = "2024",
    deps = _DEPS + ["@crates//:uuid", "@crates//:serde", "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "integration_tests/lib.rs",
    crate_name = "yolo_hub_connector_client_integration_tests",
    edition = "2024",
    deps = _DEPS + [":yolo_hub_connector_client", "@crates//:uuid", "@crates//:serde", "@crates//:tempfile", "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol"],
)
