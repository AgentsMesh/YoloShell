load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/hub/connector/protocol:yolo_hub_connector_protocol",
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:uuid",
]

_TEST_DEPS = [
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "@crates//:serde_json",
    "@crates//:tempfile",
]

rust_library(
    name = "yolo_hub_connector_store",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_connector_store",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_connector_store_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + _TEST_DEPS,
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_connector_store_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + _TEST_DEPS + [":yolo_hub_connector_store"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)
