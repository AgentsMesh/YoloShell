load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:ring",
    "@crates//:russh",
    "@crates//:serde",
    "@crates//:zeroize",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        [
            "src/**/*.rs",
            "unit_tests/**/*.rs",
            "integration_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_state",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_state",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(
        [
            "src/**/*.rs",
            "unit_tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    crate_name = "yolo_hub_state_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob([
        "integration_tests/**/*.rs",
        "test_support/integration/**/*.rs",
    ]),
    crate_name = "yolo_hub_state_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_state",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)
