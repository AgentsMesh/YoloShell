load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/dispatch:yolo_hub_dispatch",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/peer/protocol:yolo_hub_peer_protocol",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:uuid",
]

rust_library(
    name = "yolo_hub_audit",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_audit",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_hub_audit_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/agent/input:yolo_agent_input",
        "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
        "//core/crates/hub/delegation:test_support",
        "//core/crates/hub/remote/setup/protocol:test_support",
        "//core/crates/hub/remote/setup/protocol:yolo_hub_remote_setup_protocol",
        "//core/crates/transport/ssh/profile/protocol:yolo_ssh_profile_protocol",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]) + ["BUILD.bazel"],
)
