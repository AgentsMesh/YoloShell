load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/system/control/contract:yolo_agent_control_contract",
    "//core/crates/runtime/engine/protocol:yolo_runtime_protocol",
    "//core/crates/terminal/model:yolo_terminal_model",
    "//core/crates/transport/client:yolo_client",
    "//core/crates/wire:yolo_wire",
]

rust_library(
    name = "yolo_hub_agent_observe",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_agent_observe",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs"]) + ["BUILD.bazel"],
)
