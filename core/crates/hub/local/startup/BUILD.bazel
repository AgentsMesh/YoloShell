load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:test_features.bzl", "INTEGRATION_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/transport/capnp/codec",
    "//core/crates/application/launch/contract:yolo_launch_contract",
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/client:yolo_hub_client",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/state:yolo_hub_state",
    "//core/crates/hub/terminal/io:yolo_hub_terminal_io",
    "//core/crates/hub/jsonrpc/transport:yolo_hub_jsonrpc_transport",
    "//core/crates/persistence/paths:yolo_paths",
    "//core/crates/runtime/engine/process:yolo_process",
    "//core/crates/runtime/engine/startup/guard:yolo_startup_guard",
    "//core/crates/transport/client:yolo_client",
    "//core/crates/wire:yolo_wire",
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:tokio",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_local_startup",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_local_startup",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob([
        "src/**/*.rs",
        "unit_tests/**/*.rs",
        "test_support/constants.rs",
    ]),
    crate_name = "yolo_hub_local_startup_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["@crates//:tempfile"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["src/**/*.rs", "integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_local_startup_integration_tests",
    crate_root = "src/lib.rs",
    crate_features = INTEGRATION_TEST_FEATURES,
    edition = "2024",
    deps = _DEPS + ["@crates//:tempfile"],
)
