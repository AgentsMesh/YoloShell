load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/dispatch:yolo_hub_dispatch",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/local/errors:yolo_hub_local_errors",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/transport/client:yolo_client",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_local_terminal_history",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_local_terminal_history",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)
