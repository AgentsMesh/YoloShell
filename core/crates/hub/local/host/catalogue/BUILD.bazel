load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/terminal/model:yolo_terminal_model",
    "//core/crates/transport/client:yolo_client",
    "@crates//:tokio",
]

rust_library(
    name = "yolo_hub_host_catalogue",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_host_catalogue",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs"]) + ["BUILD.bazel"],
)
