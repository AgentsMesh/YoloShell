load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/persistence/lease:yolo_lease",
    "//core/crates/transport/client:yolo_client",
    "//core/crates/wire:yolo_wire",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"], allow_empty = True) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_local_errors",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_local_errors",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"], allow_empty = True),
    crate_name = "yolo_hub_local_errors_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)
