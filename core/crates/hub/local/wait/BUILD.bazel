load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel/rust:test_features.bzl", "UNIT_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/local/backend:yolo_hub_local_backend",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "@crates//:tokio",
]

rust_library(
    name = "yolo_hub_agent_wait",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_agent_wait",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_agent_wait_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    crate_features = UNIT_TEST_FEATURES,
    deps = _DEPS + ["@crates//:uuid"],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs"]) + ["BUILD.bazel"],
)
