load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel/rust:test_features.bzl", "INTEGRATION_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "yolo_hub_catalogue_events",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_catalogue_events",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//core/crates/hub/local/backend:yolo_hub_local_backend",
        "//core/crates/transport/client:yolo_client",
        "@crates//:anyhow",
        "@crates//:tokio",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs"]) + ["BUILD.bazel"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["src/**/*.rs", "integration_tests/**/*.rs"]),
    crate_name = "yolo_hub_catalogue_events_integration_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    crate_features = INTEGRATION_TEST_FEATURES,
    deps = [
        "//core/crates/hub/identity:yolo_hub_identity",
        "//core/crates/hub/local/backend:yolo_hub_local_backend",
        "//core/crates/runtime/engine/protocol:yolo_runtime_protocol",
        "//core/crates/terminal/model:yolo_terminal_model",
        "//core/crates/transport/client:yolo_client",
        "//core/crates/transport/runtime/testing",
        "//core/crates/wire:yolo_wire",
        "@crates//:anyhow",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:uuid",
    ],
)
