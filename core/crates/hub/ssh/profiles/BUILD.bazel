load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/ssh/profile/protocol:yolo_hub_ssh_profile_protocol",
    "//core/crates/persistence/paths:yolo_paths",
    "//core/crates/transport/ssh/profile/protocol:yolo_ssh_profile_protocol",
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:uuid",
]

filegroup(name = "architecture_check_data", srcs = glob(["**/*.rs"]) + ["BUILD.bazel"])

rust_library(
    name = "yolo_hub_ssh_profiles",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_ssh_profiles",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_ssh_profiles_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["//core/crates/hub/delegation:test_support", "//core/crates/hub/ssh/profile/protocol:test_support", "@crates//:serde_json", "@crates//:tempfile"],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_ssh_profiles_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_ssh_profiles",
        "//core/crates/hub/delegation:test_support",
        "//core/crates/hub/ssh/profile/protocol:test_support",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)
