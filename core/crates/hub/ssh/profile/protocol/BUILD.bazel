load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
package(default_visibility = ["//visibility:public"])
_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/transport/ssh/profile/protocol:yolo_ssh_profile_protocol",
    "@crates//:anyhow", "@crates//:serde", "@crates//:uuid",
]
_TEST_DEPS = [":test_support", "//core/crates/hub/delegation:test_support", "@crates//:serde_json"]
filegroup(name = "architecture_check_data", srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"])
rust_library(name = "yolo_hub_ssh_profile_protocol", srcs = glob(["src/**/*.rs"]), crate_name = "yolo_hub_ssh_profile_protocol", crate_root = "src/lib.rs", edition = "2024", version = YOLO_MARKETING_VERSION, deps = _DEPS)
rust_library(name = "test_support", testonly = True, srcs = glob(["test_support/**/*.rs"]), crate_name = "yolo_hub_ssh_profile_protocol_test_support", crate_root = "test_support/lib.rs", edition = "2024", deps = _DEPS + [":yolo_hub_ssh_profile_protocol", "//core/crates/hub/delegation:test_support"])
rust_test(name = "unit_tests", srcs = glob(["unit_tests/**/*.rs", "test_support/**/*.rs"]), crate_name = "yolo_hub_ssh_profile_protocol_unit_tests", crate_root = "unit_tests/lib.rs", edition = "2024", deps = _DEPS + _TEST_DEPS + [":yolo_hub_ssh_profile_protocol"])
rust_test(name = "integration_tests", srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]), crate_name = "yolo_hub_ssh_profile_protocol_integration_tests", crate_root = "integration_tests/lib.rs", edition = "2024", deps = _DEPS + _TEST_DEPS + [":yolo_hub_ssh_profile_protocol"])
