load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_identity",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_identity",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = ["//core/crates/crypto:yolo_crypto", "@crates//:serde", "@crates//:uuid"],
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_identity_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = [":yolo_hub_identity", "@crates//:serde", "@crates//:serde_json", "@crates//:uuid"],
)
