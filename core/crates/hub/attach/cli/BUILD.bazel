load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/application/launch/contract:yolo_launch_contract",
    "//core/crates/hub/relay/control/protocol:yolo_hub_relay_control_protocol",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/hub/terminal/relay:yolo_hub_terminal_relay",
    "//core/crates/hub/terminal/io:yolo_hub_terminal_io",
    "//core/crates/transport/local/unix:yolo_local_unix",
    "@crates//:anyhow",
    "@crates//:clap",
    "@crates//:libc",
    "@crates//:tokio",
    "@crates//:uuid",
    "@crates//:serde",
    "@crates//:serde_json",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_attach_cli",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_attach_cli",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(
        [
            "src/**/*.rs",
            "unit_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
    ),
    crate_name = "yolo_hub_attach_unit_tests",
    crate_features = ["yolo-unit-tests"],
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_test(
    name = "integration_tests",
    srcs = glob(["src/**/*.rs", "integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_attach_integration_tests",
    crate_features = ["yolo-integration-tests"],
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + ["//core/crates/hub/agent/protocol:yolo_hub_agent_protocol"],
)
