load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/audit:yolo_hub_audit",
    "//core/crates/hub/client/access/registry:yolo_hub_client_access_registry",
    "//core/crates/hub/client/transport:yolo_hub_client_transport",
    "//core/crates/hub/dispatch:yolo_hub_dispatch",
    "//core/crates/hub/server:yolo_hub_server",
    "//core/crates/hub/state:yolo_hub_state",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:russh",
    "@crates//:tokio",
    "@crates//:tracing",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_public_client_server",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_public_client_server",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_public_client_server_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_public_client_server",
        "//core/crates/hub/client:yolo_hub_client",
        "//core/crates/hub/client/access/protocol:yolo_hub_client_access_protocol",
        "//core/crates/hub/identity:yolo_hub_identity",
        "//core/crates/hub/routing:yolo_hub_routing",
        "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
        "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
        "@crates//:tempfile",
        "@crates//:ring",
        "//core/crates/hub/jsonrpc/transport:yolo_hub_jsonrpc_transport",
        "//core/crates/hub/jsonrpc/protocol:yolo_hub_jsonrpc_protocol",
        "//core/crates/hub/terminal/wire:yolo_hub_terminal_wire",
        "@crates//:uuid",
    ],
)
