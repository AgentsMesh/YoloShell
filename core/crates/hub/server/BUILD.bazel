load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/system/provider/contract:yolo_agent_provider_contract",
    "//core/crates/hub/audit:yolo_hub_audit",
    "//core/crates/hub/client/access/dispatch:yolo_hub_client_access_dispatch",
    "//core/crates/hub/client/access/registry:yolo_hub_client_access_registry",
    "//core/crates/hub/dispatch:yolo_hub_dispatch",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/local/backend:yolo_hub_local_backend",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/hub/state:yolo_hub_state",
    "//core/crates/hub/jsonrpc/transport:yolo_hub_jsonrpc_transport",
    "//core/crates/hub/jsonrpc/protocol:yolo_hub_jsonrpc_protocol",
    "//core/crates/hub/terminal/wire:yolo_hub_terminal_wire",
    "//core/crates/persistence/paths:yolo_paths",
    "//core/crates/transport/local/unix:yolo_local_unix",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:tokio",
    "@crates//:tracing",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        [
            "src/**/*.rs",
            "unit_tests/**/*.rs",
            "integration_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_server",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_server",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(
        [
            "src/**/*.rs",
            "unit_tests/**/*.rs",
            "test_support/**/*.rs",
        ],
        allow_empty = True,
    ),
    crate_name = "yolo_hub_server_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/transport/session:yolo_session_timing",
        "@crates//:tempfile",
        "@crates//:uuid",
    ],
)
