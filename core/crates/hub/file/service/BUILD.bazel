load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/file/executor:yolo_hub_file_executor",
    "//core/crates/hub/file/helper/protocol:yolo_hub_file_helper_protocol",
    "//core/crates/hub/file/protocol:yolo_hub_file_protocol",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "@crates//:tokio",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "integration_tests/**/*.rs", "test_support/**/*.rs"], allow_empty = True) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_file_service",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_file_service",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

isolated_rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_file_service_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    coverage_objects = ["//core:yolo"],
    env = {"YOLO_FILE_HELPER_TEST_BINARY": "$(rootpath //core:yolo)", "RUST_TEST_THREADS": "1"},
    tags = ["exclusive"],
    deps = _DEPS + [":yolo_hub_file_service", "//core/crates/hub/file/reader:test_support"],
)
