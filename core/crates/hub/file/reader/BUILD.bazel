load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/hub/file/protocol:yolo_hub_file_protocol",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:libc",
    "@crates//:serde",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "integration_tests/**/*.rs", "test_support/**/*.rs"], allow_empty = True) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_file_reader",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_file_reader",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_hub_file_reader_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)

rust_library(
    name = "test_support",
    testonly = True,
    srcs = glob(["test_support/**/*.rs"]),
    crate_name = "yolo_hub_file_reader_test_support",
    crate_root = "test_support/fixture.rs",
    edition = "2024",
    deps = [
        ":yolo_hub_file_reader",
        "//core/crates/hub/file/protocol:yolo_hub_file_protocol",
        "//core/crates/hub/identity:yolo_hub_identity",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_hub_file_reader_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_file_reader",
        "//core/crates/hub/identity:yolo_hub_identity",
        "@crates//:tempfile",
    ],
)
