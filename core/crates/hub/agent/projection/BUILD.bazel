load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/contract:yolo_agent_contract",
    "//core/crates/agent/system/adapter/contract:yolo_agent_adapter_contract",
    "//core/crates/agent/system/control/contract:yolo_agent_control_contract",
    "//core/crates/agent/system/provider/contract:yolo_agent_provider_contract",
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/persistence/paths:yolo_paths",
    "//core/crates/terminal/model:yolo_terminal_model",
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:tracing",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_hub_agent_projection",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_hub_agent_projection",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob([
        "src/**/*.rs",
        "unit_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_name = "yolo_hub_agent_projection_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob([
        "integration_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_name = "yolo_hub_agent_projection_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_hub_agent_projection",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)
