load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:test_features.bzl", "INTEGRATION_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/delegation:yolo_hub_delegation",
    "//core/crates/hub/enrollment/store:yolo_hub_enrollment_store",
    "//core/crates/distribution/bundle:yolo_distribution_bundle",
    "//core/crates/distribution/release/store:yolo_distribution_release_store",
    "//core/crates/hub/build/protocol:yolo_hub_build_protocol",
    "//core/crates/hub/client:yolo_hub_client",
    "//core/crates/hub/federation/settings:yolo_hub_federation_settings",
    "//core/crates/hub/local/startup:yolo_hub_local_startup",
    "//core/crates/hub/management/protocol:yolo_hub_management_protocol",
    "//core/crates/transport/remote/provisioning/protocol:yolo_remote_provisioning_protocol",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/hub/state:yolo_hub_state",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:tokio",
]

_TEST_DEPS = [
    "//core/crates/hub/jsonrpc/transport:yolo_hub_jsonrpc_transport",
    "//core/crates/hub/jsonrpc/protocol:yolo_hub_jsonrpc_protocol",
    "//core/crates/hub/remote/startup/protocol:test_support",
    "//core/crates/build_image:yolo_build_image",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/routing:yolo_hub_routing",
    "@crates//:serde_json",
    "@crates//:tempfile",
    "@crates//:uuid",
]

filegroup(name = "architecture_check_data", srcs = glob(["**/*.rs"]) + ["BUILD.bazel"])

rust_library(
    name = "yolo_hub_remote_startup",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_hub_remote_startup",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_hub_remote_startup_unit_tests",
    edition = "2024",
    deps = _DEPS + _TEST_DEPS,
)

rust_test(
    name = "integration_tests",
    srcs = glob(["src/**/*.rs", "integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "yolo_hub_remote_startup_integration_tests",
    crate_features = INTEGRATION_TEST_FEATURES,
    edition = "2024",
    deps = _DEPS + _TEST_DEPS,
)
