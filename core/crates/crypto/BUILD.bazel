load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

CRYPTO_SOURCES = glob(["src/**/*.rs"])

CRYPTO_TEST_SOURCES = glob(
    [
        "unit_tests/**/*.rs",
        "integration_tests/**/*.rs",
    ],
    allow_empty = True,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
    ],
)

rust_library(
    name = "yolo_crypto",
    srcs = CRYPTO_SOURCES,
    crate_name = "yolo_crypto",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = [
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:ring",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "yolo_crypto_unit_tests",
    srcs = CRYPTO_TEST_SOURCES,
    crate_name = "yolo_crypto_test",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = [
        ":yolo_crypto",
        "@crates//:sha2",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:uuid",
    ],
)
