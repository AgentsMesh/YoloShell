load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/distribution/bundle:yolo_distribution_bundle",
    "//core/crates/distribution/publication/protocol:yolo_distribution_publication_protocol",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:uuid",
]

_TEST_DEPS = ["@crates//:tempfile"]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_distribution_release_store",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_distribution_release_store",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_distribution_release_store_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + _TEST_DEPS,
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_distribution_release_store_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + _TEST_DEPS + [":yolo_distribution_release_store"],
)
