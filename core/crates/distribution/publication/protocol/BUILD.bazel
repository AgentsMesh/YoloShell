load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/transport/capnp/codec",
    "//core/crates/transport/capnp/argument",
    "//core/crates/distribution/bundle:yolo_distribution_bundle",
    "@crates//:anyhow",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:uuid",
]

filegroup(name = "architecture_check_data", srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"])

rust_library(name = "yolo_distribution_publication_protocol", srcs = glob(["src/**/*.rs"]), crate_name = "yolo_distribution_publication_protocol", crate_root = "src/lib.rs", edition = "2024", version = YOLO_MARKETING_VERSION, deps = _DEPS)

rust_test(name = "unit_tests", srcs = glob(["unit_tests/**/*.rs", "test_support/**/*.rs"]), crate_name = "yolo_distribution_publication_protocol_unit_tests", crate_root = "unit_tests/lib.rs", edition = "2024", deps = _DEPS + [":yolo_distribution_publication_protocol"])

rust_test(name = "integration_tests", srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]), crate_name = "yolo_distribution_publication_protocol_integration_tests", crate_root = "integration_tests/lib.rs", edition = "2024", deps = _DEPS + [":yolo_distribution_publication_protocol"])
