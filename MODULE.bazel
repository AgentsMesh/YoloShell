module(
    name = "yolo",
    version = "0.1.7",
)

bazel_dep(name = "rules_rust", version = "0.69.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "capnp-cpp", version = "1.2.0")

single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = [
        "//third_party/rules_rust:coverage_collector.patch",
        "//third_party/rules_rust:darwin_continuous_coverage.patch",
    ],
    version = "0.69.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.93.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Local coverage experiments are selected only by --config=rust_coverage_direct.
coverage_rustc_receipt = use_repo_rule(
    "//build_system/coverage/compiler:repositories.bzl",
    "coverage_rustc_receipt",
)

coverage_rustc_receipt(name = "yolo_coverage_rustc_build")

coverage_rustc_toolchain = use_repo_rule(
    "//build_system/coverage/compiler:repositories.bzl",
    "coverage_rustc_toolchain",
)

coverage_rustc_toolchain(
    name = "yolo_coverage_rustc",
    receipt = "@yolo_coverage_rustc_build//:build-receipt.json",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "vt100",
    patch_args = ["-p1"],
    patches = ["//build_system/bazel/rust/dependencies/vt100:cursor_position.patch"],
    version = "=0.16.2",
)
crate.annotation(
    crate = "vte",
    patch_args = ["-p1"],
    patches = [
        "//build_system/bazel/rust/dependencies/vte:osc_buffer.patch",
        "//build_system/bazel/rust/dependencies/vte:osc_completion.patch",
    ],
    version = "=0.15.0",
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

http_file = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_file",
)

http_file(
    name = "bazel_linux_amd64",
    executable = True,
    sha256 = "7ff2b6a675b59a791d007c526977d5262ade8fa52efc8e0d1ff9e18859909fc0",
    urls = [
        "https://github.com/bazelbuild/bazel/releases/download/8.2.1/bazel-8.2.1-linux-x86_64",
    ],
)

http_file(
    name = "bazel_linux_arm64",
    executable = True,
    sha256 = "1f50df607751a56ace7775872ffb5dff4c15c25c11a2df30b7b0035ef53a9937",
    urls = [
        "https://github.com/bazelbuild/bazel/releases/download/8.2.1/bazel-8.2.1-linux-arm64",
    ],
)

DOCKER_MACOS_ARM64_ARCHIVE_SHA256 = "a3a6a503fad49d3a4490bb7b8e1526e448736bc9a65e629fb4e22398b903853d"

DOCKER_MACOS_ARM64_ARCHIVE_URL = "https://download.docker.com/mac/static/stable/aarch64/docker-29.4.0.tgz"

http_archive(
    name = "docker_macos_arm64",
    build_file = "//third_party/docker:BUILD.docker.bazel",
    sha256 = DOCKER_MACOS_ARM64_ARCHIVE_SHA256,
    strip_prefix = "docker",
    urls = [DOCKER_MACOS_ARM64_ARCHIVE_URL],
)

local_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "local_repository",
)

local_repository(
    name = "yolo_linux_artifacts",
    path = "build_system/platform/linux",
)

