load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build_system/bazel/rust:adversarial.bzl", "ADVERSARIAL_TEST_FEATURES")
load("//build_system/bazel/rust:creation_recovery_tests.bzl", "CREATION_RECOVERY_AUDIT_UNIT_DEPS", "CREATION_RECOVERY_AUDIT_UNIT_SRCS")
load("//build_system/bazel/rust:config.bzl", "FAKE_AGENT_DEPS", "FAKE_CLAUDE_CONTRACT_SRCS", "RUNTIME_ARCHITECTURE_DATA", "RUNTIME_DEPS", "TEST_ENVIRONMENT")
load("//build_system/bazel/rust:native_interrupt_driver_tests.bzl", "NATIVE_INTERRUPT_DRIVER_UNIT_SRCS")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load("//build_system/bazel/rust:runtime_hub_integration.bzl", "CONNECTOR_FIXTURE_ARCHITECTURE_DATA", "HUB_BUNDLE_TEST_OBJECTS", "HUB_CONNECTOR_TEST_OBJECTS", "HUB_FILE_TEST_OBJECTS", "HUB_INTEGRATION_DEPS", "HUB_QUERY_TEST_OBJECTS", "native_hub_environment", "native_hub_probe_data")
load(
    "//build_system/bazel/rust:relay_dimensions_tests.bzl",
    "RELAY_DIMENSIONS_UNIT_ALIASES",
    "RELAY_DIMENSIONS_UNIT_DEPS",
    "RELAY_DIMENSIONS_UNIT_SRCS",
)
load("//build_system/bazel/rust:test_features.bzl", "SERIAL_TEST_ENVIRONMENT", "UNIT_TEST_FEATURES")

rust_binary(
    name = "yolo-test-codex",
    testonly = True,
    srcs = glob(["fake_agent/**/*.rs"]),
    crate_name = "yolo_test_codex",
    crate_root = "fake_agent/main.rs",
    edition = "2024",
    visibility = [
        "//core:__pkg__",
        "//plugins/macos:__pkg__",
        "//plugins/macos/Tests/NativeIntegration:__pkg__",
    ],
    deps = FAKE_AGENT_DEPS,
)

rust_binary(
    name = "yolo-test-claude",
    testonly = True,
    srcs = glob(["fake_agent/**/*.rs"]),
    crate_name = "yolo_test_claude",
    crate_root = "fake_agent/main.rs",
    edition = "2024",
    visibility = [
        "//core:__pkg__",
        "//plugins/macos:__pkg__",
        "//plugins/macos/Tests/NativeIntegration:__pkg__",
    ],
    deps = FAKE_AGENT_DEPS,
)

rust_test(
    name = "fake_agent_unit_tests",
    srcs = glob(["fake_agent/**/*.rs"]),
    crate_name = "yolo_test_codex_test",
    crate_root = "fake_agent/main.rs",
    edition = "2024",
    visibility = ["//core:__pkg__"],
    deps = FAKE_AGENT_DEPS + [
        "//core/crates/agent/system/hooks/installation:yolo_hook_installation",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "fake_claude_contract_test",
    srcs = FAKE_CLAUDE_CONTRACT_SRCS,
    crate_name = "fake_claude_contract_test",
    crate_root = "fake_claude_contract.rs",
    data = [":yolo-test-claude"],
    edition = "2024",
    env = {"YOLO_TEST_CLAUDE_BINARY": "$(rootpath :yolo-test-claude)"},
    visibility = ["//core:__pkg__"],
    deps = [
        "//core:yolo_runtime",
        "@crates//:libc",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "relay_dimensions_unit_tests",
    srcs = RELAY_DIMENSIONS_UNIT_SRCS,
    aliases = RELAY_DIMENSIONS_UNIT_ALIASES,
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "relay_dimensions_unit_tests",
    crate_root = "resilience/relay/unit_tests/lib.rs",
    edition = "2024",
    env = SERIAL_TEST_ENVIRONMENT,
    visibility = ["//:__pkg__", "//core:__pkg__"],
    deps = RELAY_DIMENSIONS_UNIT_DEPS,
)

rust_test(
    name = "native_interrupt_driver_unit_tests",
    srcs = NATIVE_INTERRUPT_DRIVER_UNIT_SRCS,
    crate_features = UNIT_TEST_FEATURES,
    crate_name = "native_interrupt_driver_unit_tests",
    crate_root = "resilience/hub/native/native_control_tui/unit_tests/lib.rs",
    edition = "2024",
    visibility = ["//:__pkg__", "//core:__pkg__"],
)

NATIVE_HUB_PROBE_DATA = native_hub_probe_data()
rust_test(
    name = "creation_recovery_audit_unit_tests",
    srcs = CREATION_RECOVERY_AUDIT_UNIT_SRCS,
    crate_name = "creation_recovery_audit_unit_tests",
    crate_root = "resilience/hub/tui_creation/tui_creation_recovery/unit_tests/lib.rs",
    edition = "2024",
    visibility = ["//:__pkg__", "//core:__pkg__"],
    deps = CREATION_RECOVERY_AUDIT_UNIT_DEPS,
)

rust_test(
    name = "tui_chat_driver_unit_tests",
    srcs = glob(["resilience/hub/tui_chat/unit_tests/*.rs"]) + [
        "resilience/hub/tui_chat/test_support/submissions.rs",
    ],
    crate_name = "tui_chat_driver_unit_tests",
    crate_root = "resilience/hub/tui_chat/unit_tests/lib.rs",
    edition = "2024",
    visibility = ["//:__pkg__", "//core:__pkg__"],
    deps = ["@crates//:serde_json"],
)

isolated_rust_test(
    name = "runtime_resilience_test",
    timeout = "eternal",
    srcs = [
        "fake_agent/constants.rs",
        "fake_agent/invocation.rs",
        "resilience.rs",
    ] + glob(["resilience/**/*.rs"], exclude = ["resilience/**/unit_tests/**/*.rs"]),
    aliases = {
        "//core/crates/runtime/engine/process:yolo_process_component_test_support": "yolo_process_test_support",
        "//core/crates/transport/client:yolo_client_adversarial": "yolo_client",
        "//core/crates/transport/relay:yolo_relay_adversarial": "yolo_relay",
        "//core/crates/transport/remote:yolo_remote_adversarial": "yolo_remote",
        "//core/crates/transport/remote/broker:yolo_remote_broker_adversarial": "yolo_remote_broker",
    },
    coverage_objects = depset([
        "//core/crates/runtime/engine/startup/guard:startup_parent",
        ":yolo-test-claude",
        ":yolo-test-codex",
        "//core/crates/application/yolo:yolo",
        "//core:yolo-adversarial",
    ] + HUB_FILE_TEST_OBJECTS + HUB_CONNECTOR_TEST_OBJECTS + HUB_QUERY_TEST_OBJECTS + HUB_BUNDLE_TEST_OBJECTS).to_list(),
    crate_features = ADVERSARIAL_TEST_FEATURES,
    crate_name = "runtime_resilience_test",
    crate_root = "resilience.rs",
    data = [
        ":yolo-test-claude",
        ":yolo-test-codex",
        "//core/crates/application/yolo:yolo",
        "//core:yolo-adversarial",
    ] + [NATIVE_HUB_PROBE_DATA],
    edition = "2024",
    env = native_hub_environment({
        "RUST_TEST_THREADS": "1",
        "YOLO_ATTACH_BINARY": "$(rootpath //core/crates/application/yolo:yolo)",
        "YOLO_TEST_RUNTIME": "$(rootpath //core:yolo-adversarial)",
        "YOLO_TEST_TUI_BINARY": "$(rootpath //core/crates/application/yolo:yolo)",
        "YOLO_TEST_HUB_ATTACH_BINARY": "$(rootpath //core/crates/application/yolo:yolo)",
        "YOLO_TEST_HUB_BINARY": "$(rootpath //core/crates/application/yolo:yolo)",
    }),
    env_inherit = TEST_ENVIRONMENT,
    tags = [
        "exclusive",
        "no-sandbox",
    ],
    visibility = [
        "//:__pkg__",
        "//core:__pkg__",
    ],
    deps = RUNTIME_DEPS + HUB_INTEGRATION_DEPS + [
        "//core/crates/conversation/protocol:yolo_conversation_protocol",
        "//core/crates/hub/conversation/client:yolo_hub_conversation_client",
        "//build_system/coverage/profile_test_support:library",
        "//core:yolo_runtime_adversarial",
        "//core/crates/agent/system/core:yolo_agent_core",
        "//core/crates/agent/system/hooks/installation:yolo_hook_installation",
        "//core/crates/runtime/engine/process:yolo_process_component_test_support",
        "//core/crates/runtime/engine/resilience/support:yolo_resilience_support",
        "//core/crates/transport/client:yolo_client_adversarial",
        "//core/crates/transport/relay:yolo_relay_adversarial",
        "//core/crates/transport/remote:yolo_remote_adversarial",
        "//core/crates/transport/remote/broker:yolo_remote_broker_adversarial",
        "//core/crates/transport/session:yolo_session_timing",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + RUNTIME_ARCHITECTURE_DATA + CONNECTOR_FIXTURE_ARCHITECTURE_DATA,
    visibility = ["//visibility:public"],
)
