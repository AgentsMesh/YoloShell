load("@rules_rust//rust:defs.bzl", "rust_test")

package(default_visibility = [
    "//core:__pkg__",
    "//integration_tests/runtime:__pkg__",
])

rust_test(
    name = "runtime_protocol_test",
    srcs = ["protocol.rs"],
    crate_name = "runtime_protocol_test",
    edition = "2024",
    deps = [
        "//core:yolo_runtime",
        "//core/crates/transport/capnp/value",
        "@crates//:serde",
        "@crates//:serde_bytes",
        "@crates//:uuid",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)
