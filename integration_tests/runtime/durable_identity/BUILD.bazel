load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "driver",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_durable_identity_remount_driver",
    crate_root = "src/main.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//core/crates/hub/configuration/store:yolo_hub_configuration_store",
        "//core/crates/hub/delegation:yolo_hub_delegation",
        "//core/crates/hub/identity:yolo_hub_identity",
        "//core/crates/hub/management/protocol:yolo_hub_management_protocol",
        "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
        "//core/crates/hub/state:yolo_hub_state",
        "//core/crates/persistence/paths:yolo_paths",
        "//clients/tui/creation/journal:yolo_tui_creation_journal",
        "@crates//:anyhow",
        "@crates//:libc",
        "@crates//:serde",
        "@crates//:uuid",
    ],
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs"]) + ["BUILD.bazel", "README.md"],
)
