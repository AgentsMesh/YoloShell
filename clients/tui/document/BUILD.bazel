load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//clients/tui/render:yolo_tui_render",
    "//clients/tui/tab:yolo_tui_tab",
    "@crates//:crossterm",
    "@crates//:ratatui",
    "@crates//:serde_json",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_tui_document",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_tui_document",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/**/*.rs"]),
    crate_name = "yolo_tui_document_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [":yolo_tui_document"],
)
