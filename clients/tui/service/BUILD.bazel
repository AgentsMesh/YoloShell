load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/application/local/lifecycle:yolo_local_lifecycle",
    "//core/crates/application/local/profile:yolo_local_profile",
    "//core/crates/build_image:yolo_build_image",
    "@crates//:anyhow",
    "@crates//:clap",
    "@crates//:serde",
    "@crates//:serde_json",
]

rust_library(
    name = "yolo_tui_service",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_tui_service",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)
