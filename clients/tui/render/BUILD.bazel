load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/presentation/layout:yolo_presentation_layout",
    "//clients/tui/lifecycle:yolo_tui_lifecycle",
    "@crates//:ratatui",
    "@crates//:uuid",
    "@crates//:vt100",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_tui_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_tui_render",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["unit_tests/**/*.rs"]),
    crate_name = "yolo_tui_render_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [":yolo_tui_render"],
)
