load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//clients/tui/selection:yolo_tui_selection",
    "@crates//:crossterm",
    "@crates//:ratatui",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_tui_screen",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_tui_screen",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)
