load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")
load("//build_system/bazel/rust:test_features.bzl", "INTEGRATION_TEST_FEATURES")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:serde",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_tui_creation_journal",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_tui_creation_journal",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_tui_creation_journal_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/wire:yolo_wire",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["src/**/*.rs", "integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_tui_creation_journal_integration_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    crate_features = INTEGRATION_TEST_FEATURES,
    deps = _DEPS + [
        "//core/crates/wire:yolo_wire",
        "@crates//:libc",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:uuid",
    ],
)
