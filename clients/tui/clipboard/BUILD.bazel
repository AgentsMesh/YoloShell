load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//clients/tui/input/line:yolo_tui_line_input",
    "//clients/tui/selection:yolo_tui_selection",
    "//core/crates/conversation/protocol:yolo_conversation_protocol",
    "//core/crates/hub/client:yolo_hub_client",
    "//core/crates/hub/identity:yolo_hub_identity",
    "@crates//:anyhow",
    "@crates//:crossterm",
    "@crates//:libc",
    "@crates//:ratatui",
    "@crates//:tokio",
    "@crates//:url",
] + select({
    "@platforms//os:macos": [":pasteboard"],
    "//conditions:default": [],
})

cc_library(
    name = "pasteboard",
    srcs = ["src/pasteboard.c"],
    linkopts = ["-Wl,-framework,ApplicationServices", "-Wl,-framework,CoreFoundation", "-Wl,-framework,ImageIO"],
    target_compatible_with = ["@platforms//os:macos"],
)

filegroup(name = "architecture_check_data", srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"])

rust_library(
    name = "yolo_tui_clipboard",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_tui_clipboard",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_tui_clipboard_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS,
)
