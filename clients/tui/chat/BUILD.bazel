load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/input:yolo_agent_input",
    "//core/crates/conversation/protocol:yolo_conversation_protocol",
    "//core/crates/crypto:yolo_crypto",
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "@crates//:ratatui",
    "@crates//:uuid",
]

filegroup(name = "architecture_check_data", srcs = glob(["**/*.rs"]) + ["BUILD.bazel"])

rust_library(
    name = "yolo_tui_chat",
    crate_name = "yolo_tui_chat",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

_TEST_DEPS = _DEPS + [
    ":yolo_tui_chat",
    "//core/crates/hub/identity:yolo_hub_identity",
]

rust_test(
    name = "unit_tests",
    crate_name = "yolo_tui_chat_unit_tests",
    crate_root = "unit_tests/lib.rs",
    srcs = glob(["unit_tests/**/*.rs", "test_support/**/*.rs"]),
    edition = "2024",
    deps = _TEST_DEPS,
)

rust_test(
    name = "integration_tests",
    crate_name = "yolo_tui_chat_integration_tests",
    crate_root = "integration_tests/lib.rs",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    edition = "2024",
    deps = _TEST_DEPS,
)
