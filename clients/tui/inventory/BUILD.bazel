load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/hub/workspace/protocol:yolo_hub_workspace_protocol",
    "//clients/tui/lifecycle:yolo_tui_lifecycle",
    "@crates//:ratatui",
]

filegroup(name = "architecture_check_data", srcs = glob(["**/*"], exclude = ["BUILD.bazel"]) + ["BUILD.bazel"])

rust_library(name = "yolo_tui_inventory", srcs = glob(["src/**/*.rs"]), crate_name = "yolo_tui_inventory", crate_root = "src/lib.rs", edition = "2024", version = YOLO_MARKETING_VERSION, deps = _DEPS)

rust_test(name = "unit_tests", srcs = glob(["unit_tests/**/*.rs", "test_support/**/*.rs"]), crate_name = "yolo_tui_inventory_unit_tests", crate_root = "unit_tests/lib.rs", edition = "2024", deps = _DEPS + [":yolo_tui_inventory", "@crates//:uuid"])

rust_test(name = "integration_tests", srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]), crate_name = "yolo_tui_inventory_integration_tests", crate_root = "integration_tests/lib.rs", edition = "2024", deps = _DEPS + [":yolo_tui_inventory", "@crates//:uuid"])
