load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel/rust:isolated_test.bzl", "isolated_rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/agent/catalog:yolo_agent_catalog",
    "//core/crates/application/launch/contract:yolo_launch_contract",
    "//core/crates/application/local/profile:yolo_local_profile",
    "//clients/tui/audit:yolo_tui_audit",
    "//core/crates/hub/agent/protocol:yolo_hub_agent_protocol",
    "//core/crates/hub/agent/run/protocol:yolo_hub_agent_run_protocol",
    "//core/crates/hub/catalog/client:yolo_hub_catalog_client",
    "//core/crates/hub/state:yolo_hub_state",
    "//core/crates/hub/ssh/entry:yolo_hub_ssh_entry",
    "//core/crates/hub/client:yolo_hub_client",
    "//core/crates/hub/identity:yolo_hub_identity",
    "//core/crates/hub/rpc/protocol:yolo_hub_rpc_protocol",
    "//core/crates/hub/events/protocol:yolo_hub_events_protocol",
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//core/crates/hub/workspace/protocol:yolo_hub_workspace_protocol",
    "//clients/tui/app:yolo_tui_app",
    "//clients/tui/hub/cli:yolo_tui_hub_cli",
    "//clients/tui/service:yolo_tui_service",
    "//clients/tui/local/startup:yolo_tui_local_startup",
    "//clients/tui/client/control:yolo_tui_client_control",
    "//clients/tui/tab:yolo_tui_tab",
    "//core/crates/plugin/client/host:yolo_builtin_client_host",
    "//clients/tui/descriptor:yolo_tui_descriptor",
    "//core/crates/persistence/paths:yolo_paths",
    "@crates//:anyhow",
    "@crates//:clap",
    "@crates//:serde",
    "@crates//:tokio",
    "@crates//:russh",
    "@crates//:zeroize",
    "@crates//:serde_json",
    "@crates//:uuid",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(["**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_tui_cli",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_tui_cli",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_tui_bin_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        "//core/crates/hub/client/transport:yolo_hub_client_transport",
        "//core/crates/hub/delegation:yolo_hub_delegation",
        "//core/crates/hub/enrollment/protocol:yolo_hub_enrollment_protocol",
        "//core/crates/hub/federation/settings:yolo_hub_federation_settings",
        "//core/crates/hub/management/protocol:yolo_hub_management_protocol",
        "//core/crates/hub/routing:yolo_hub_routing",
        "@crates//:ring",
        "@crates//:tempfile",
    ],
)

isolated_rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_tui_bin_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    coverage_objects = ["//core:yolo"],
    env = {"YOLO_TUI_TEST_BINARY": "$(rootpath //core:yolo)"},
    deps = [
        "//core/crates/application/launch/contract:yolo_launch_contract",
        "//core/crates/hub/client:yolo_hub_client",
        "//core/crates/runtime/engine/process:yolo_process",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
