load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//core/crates/hub/terminal/protocol:yolo_hub_terminal_protocol",
    "//plugins/tui/terminal/queries:yolo_tui_terminal_queries",
    "@crates//:vt100",
]

filegroup(
    name = "architecture_check_data",
    srcs = glob(
        ["**/*"],
        exclude = ["BUILD.bazel"],
    ) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_tui_terminal",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_tui_terminal",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = _DEPS,
)

rust_test(
    name = "unit_tests",
    srcs = glob([
        "unit_tests/**/*.rs",
        "test_support/**/*.rs",
    ]),
    crate_name = "yolo_tui_terminal_unit_tests",
    crate_root = "unit_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_tui_terminal",
        "//core/crates/hub/identity:yolo_hub_identity",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "integration_tests",
    srcs = glob(["integration_tests/**/*.rs", "test_support/**/*.rs"]),
    crate_name = "yolo_tui_terminal_integration_tests",
    crate_root = "integration_tests/lib.rs",
    edition = "2024",
    deps = _DEPS + [
        ":yolo_tui_terminal",
        "//core/crates/hub/identity:yolo_hub_identity",
        "@crates//:uuid",
    ],
)
