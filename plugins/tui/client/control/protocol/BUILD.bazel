load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build_system/bazel:version.bzl", "YOLO_MARKETING_VERSION")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "architecture_check_data",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]) + ["BUILD.bazel"],
)

rust_library(
    name = "yolo_tui_client_control_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yolo_tui_client_control_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = ["@crates//:serde", "@crates//:uuid"],
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs", "unit_tests/**/*.rs"]),
    crate_name = "yolo_tui_client_control_protocol_unit_tests",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = YOLO_MARKETING_VERSION,
    deps = [
        ":yolo_tui_client_control_protocol",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:uuid",
    ],
)
