package(default_visibility = ["//visibility:public"])

filegroup(
    name = "architecture_check_data",
    srcs = ["BUILD.bazel"] + glob([
        "*.json",
        "*.md",
        "browser/*.ts",
        "scripts/*.ts",
        "scripts/e2e/*.ts",
        "server/*.ts",
        "server/*.css",
        "shared/*.ts",
        "unit_tests/*.ts",
        "vendor/manifest.json",
    ], allow_empty = True),
)

sh_test(
    name = "browser_e2e",
    srcs = ["scripts/browser_e2e.sh"],
    data = glob(["scripts/**/*.ts"]),
    tags = ["manual"],
)
